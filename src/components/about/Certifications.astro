---
---

<section class="certifications-section section-pad">
  <div class="container">
    <div class="section-header reveal" style="text-align: center; margin-bottom: 4rem;">
      <span class="text-eyebrow">Quality & Standards</span>
      <h2 class="text-h2" style="margin-top: 1rem;">Company Certifications</h2>
    </div>

    <div class="cert-grid reveal" style="transition-delay: 0.2s;">
      <div class="cert-item">
        <div class="cert-icon-wrapper">
          <img src="/images/certi-icon1.png" alt="Certification 1" loading="lazy" />
        </div>
        <p class="text-eyebrow">Quality Management</p>
      </div>
      
      <div class="cert-item">
        <div class="cert-icon-wrapper">
          <img src="/images/certi-icon2.png" alt="Certification 2" loading="lazy" />
        </div>
        <p class="text-eyebrow">Safety Standards</p>
      </div>
      
      <div class="cert-item">
        <div class="cert-icon-wrapper">
          <img src="/images/certi-icon3.png" alt="Certification 3" loading="lazy" />
        </div>
        <p class="text-eyebrow">Environmental Compliance</p>
      </div>
      
      <div class="cert-item">
        <div class="cert-icon-wrapper">
          <img src="/images/certi-icon5.png" alt="Certification 4" loading="lazy" />
        </div>
        <p class="text-eyebrow">Excellence in Engineering</p>
      </div>
    </div>
  </div>
</section>

<style>
  .certifications-section {
    background-color: var(--c-soft-white);
  }

  .cert-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3rem;
  }

  .cert-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 200px;
  }

  .cert-icon-wrapper {
    width: 100px;
    height: 100px;
    background-color: var(--c-accent); /* Changed to accent color */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: transform 0.4s ease;
  }

  .cert-item:hover .cert-icon-wrapper {
    transform: translateY(-10px);
    background-color: var(--c-charcoal);
  }

  .cert-icon-wrapper img {
    max-width: 50%;
    max-height: 50%;
    object-fit: contain;
    filter: brightness(0) invert(1); /* Makes the black/grey icon white */
    transition: filter 0.4s ease;
  }
</style>
