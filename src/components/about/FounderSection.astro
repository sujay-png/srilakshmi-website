---
import { siteData } from '../../data/site';
---

<section class="founder section-pad section-muted">
  <div class="container">
    <div class="founder__header reveal">
      <div class="founder__label">
        <span class="text-eyebrow">02 / Leadership</span>
        <span class="founder__line reveal-line"></span>
      </div>
      <span class="founder__index" aria-hidden="true">01</span>
    </div>

    <div class="founder__grid">
      <div class="founder__visual reveal-left">
        <div class="founder__frame">
          <div class="founder__image-wrap">
            <img
              src="/images/suresh.png"
              alt={siteData.founder.name}
              class="founder__image"
              loading="lazy"
              onerror="this.src='/images/srilakshmiconstructionlogo-1.png'"
            />
          </div>
          <span class="founder__badge">Est. {siteData.founder.established}</span>
          <span class="founder__frame-accent" aria-hidden="true"></span>
        </div>
      </div>

      <div class="founder__content reveal-right" style="transition-delay: 0.12s;">
        <h2 class="founder__name">{siteData.founder.name}</h2>
        <p class="founder__role">{siteData.founder.title}</p>
        <p class="founder__bio">
          With {siteData.founder.experience} of experience in the construction field, {siteData.founder.name.split(' ')[0]} leads Sri Lakshmi Construction with a vision rooted in quality, integrity, and community impact.
        </p>

        <div class="founder__metrics">
          <div class="founder__metric">
            <span class="founder__metric-value">21+</span>
            <span class="founder__metric-label">Years Experience</span>
          </div>
          <span class="founder__metric-divider" aria-hidden="true"></span>
          <div class="founder__metric">
            <span class="founder__metric-value">{siteData.founder.established}</span>
            <span class="founder__metric-label">Established</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founder {
    position: relative;
    overflow: hidden;
  }

  .founder::before {
    content: '';
    position: absolute;
    top: -20%;
    left: -10%;
    width: 50%;
    height: 80%;
    background: radial-gradient(ellipse, var(--c-saffron-soft) 0%, transparent 70%);
    pointer-events: none;
    opacity: 0.6;
  }

  .founder__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    position: relative;
    z-index: 1;
  }

  .founder__line {
    display: block;
    width: 48px;
    height: 2px;
    background-color: var(--c-saffron);
    margin-top: 1.25rem;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1s var(--ease-out-expo);
  }

  .reveal.active .founder__line {
    transform: scaleX(1);
  }

  .founder__index {
    font-family: var(--font-heading);
    font-size: clamp(4rem, 10vw, 7.5rem);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--c-saffron);
    opacity: 0.08;
    user-select: none;
    flex-shrink: 0;
  }

  .founder__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .founder__grid {
      grid-template-columns: minmax(0, 280px) 1fr;
      gap: 3rem 4rem;
    }
  }

  @media (min-width: 1024px) {
    .founder__grid {
      grid-template-columns: minmax(0, 300px) 1fr;
      gap: 3.5rem 6rem;
    }
  }

  .founder__visual {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .founder__visual {
      justify-content: flex-start;
    }
  }

  .founder__frame {
    position: relative;
    width: min(100%, 280px);
  }

  @media (min-width: 1024px) {
    .founder__frame {
      width: 300px;
    }
  }

  .founder__image-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--c-border);
    background: var(--c-surface-2);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.12);
  }

  .founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(20%);
    transition: filter 0.6s var(--ease-out-expo), transform 0.8s var(--ease-out-expo);
  }

  .founder__frame:hover .founder__image {
    filter: grayscale(0%);
    transform: scale(1.04);
  }

  .founder__badge {
    position: absolute;
    bottom: 1rem;
    left: -0.75rem;
    padding: 0.5rem 0.9rem;
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-on-saffron);
    background: var(--c-saffron);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 24px var(--c-saffron-glow);
    z-index: 2;
  }

  .founder__frame-accent {
    position: absolute;
    top: 1.5rem;
    right: -1rem;
    width: 70%;
    height: 70%;
    border: 1px solid var(--c-saffron);
    border-radius: var(--radius-lg);
    opacity: 0.35;
    z-index: -1;
    pointer-events: none;
  }

  .founder__content {
    max-width: 640px;
  }

  @media (min-width: 768px) {
    .founder__content {
      padding-top: 0.5rem;
    }
  }

  .founder__name {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 0.75rem;
    color: var(--c-text);
  }

  .founder__role {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-saffron);
    margin: 0 0 1.75rem;
  }

  .founder__bio {
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.75;
    color: var(--c-text-muted);
    margin: 0 0 2.5rem;
    max-width: 52ch;
  }

  .founder__metrics {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-border);
  }

  .founder__metric-value {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--c-text);
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .founder__metric-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .founder__metric-divider {
    width: 1px;
    height: 40px;
    background: var(--c-border);
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .founder__index {
      display: none;
    }

    .founder__frame-accent {
      display: none;
    }

    .founder__badge {
      left: 0.75rem;
      bottom: 0.75rem;
    }

    .founder__metrics {
      gap: 1.5rem;
    }
  }
</style>
