---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<a
  href={`/projects#${project.id}`}
  class={`project-card project-card-hover ${featured ? 'project-card--featured' : ''}`}
  data-category={project.category}
  data-cursor="EXPLORE →"
>
  <div class="project-image-wrapper">
    <img src={project.image} alt={project.title} loading="lazy" />
    <div class="project-overlay">
      <span class="project-view-btn">
        View Project
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>
  <div class="project-info">
    <span class="project-category text-eyebrow">{project.category}</span>
    <h3 class="project-title text-h3">{project.title}</h3>
    <span class="project-location">{project.location}</span>
  </div>
</a>

<style>
  .project-card {
    display: block;
    position: relative;
    background-color: var(--c-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.6s var(--ease-out-expo), box-shadow 0.6s var(--ease-out-expo);
  }

  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
  }

  .project-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16/10;
    overflow: hidden;
    background-color: var(--c-grey-light);
  }

  .project-card--featured .project-image-wrapper {
    aspect-ratio: 21/9;
  }

  .project-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out-expo);
  }

  .project-card:hover .project-image-wrapper img {
    transform: scale(1.06);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-expo);
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .project-view-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-white);
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(12px);
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(255,255,255,0.25);
    transform: translateY(12px);
    transition: transform 0.5s var(--ease-out-expo);
  }

  .project-card:hover .project-view-btn {
    transform: translateY(0);
  }

  .project-info {
    padding: 1.75rem 2rem;
    position: relative;
  }

  .project-info::before {
    content: '';
    position: absolute;
    top: 0;
    left: 2rem;
    right: 2rem;
    height: 1px;
    background: var(--c-grey-light);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out-expo);
  }

  .project-card:hover .project-info::before {
    transform: scaleX(1);
  }

  .project-category {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
  }

  .project-title {
    margin-bottom: 0.35rem;
    color: var(--c-charcoal);
    transition: color 0.3s ease;
  }

  .project-card:hover .project-title {
    color: var(--c-charcoal-light);
  }

  .project-location {
    font-size: 0.875rem;
    color: var(--c-grey);
  }
</style>
