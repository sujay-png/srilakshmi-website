---
import { projects, categories } from '../../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const displayProjects = limit ? projects.slice(0, limit) : projects;
---

<div class="projects-section">
  {!limit && (
    <div class="project-filters reveal">
      <div class="filter-track">
        <ul class="filter-list" id="filter-list">
          {categories.map((cat, index) => (
            <li>
              <button class={`filter-btn ${index === 0 ? 'active' : ''}`} data-filter={cat}>{cat}</button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <div class="project-grid" id="project-grid">
    {displayProjects.map((project, index) => (
      <div class="project-item reveal-scale" style={`transition-delay: ${(index % 3) * 0.08}s;`} data-category={project.category}>
        <ProjectCard project={project} />
      </div>
    ))}
  </div>
</div>

<style>
  .project-filters {
    margin-bottom: 3.5rem;
  }

  .filter-track {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  .filter-track::-webkit-scrollbar {
    display: none;
  }

  .filter-list {
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem;
    width: max-content;
    margin: 0 auto;
    background: var(--c-white);
    border-radius: 100px;
    border: 1px solid var(--c-grey-light);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
  }

  .filter-btn {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-grey);
    padding: 0.75rem 1.5rem;
    border-radius: 100px;
    transition: all 0.4s var(--ease-out-expo);
    background: transparent;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    position: relative;
  }

  .filter-btn:hover {
    color: var(--c-charcoal);
  }

  .filter-btn.active {
    color: var(--c-charcoal);
    background: var(--c-accent);
    box-shadow: 0 4px 16px var(--c-saffron-glow);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .project-item {
    transition: opacity 0.5s var(--ease-out-expo), transform 0.5s var(--ease-out-expo);
  }

  .project-item.hidden {
    opacity: 0;
    transform: scale(0.92);
    pointer-events: none;
    position: absolute;
    visibility: hidden;
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      projectItems.forEach(item => {
        const category = item.getAttribute('data-category');
        if (filter === 'All' || category === filter) {
          item.classList.remove('hidden');
          (item as HTMLElement).style.position = 'relative';
        } else {
          item.classList.add('hidden');
          setTimeout(() => {
            if (item.classList.contains('hidden')) {
              (item as HTMLElement).style.position = 'absolute';
            }
          }, 500);
        }
      });
    });
  });
</script>
