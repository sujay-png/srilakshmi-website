---
---

<section class="stats-section section-pad">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <h3 class="stat-number">21+</h3>
        <p class="stat-label text-eyebrow">Years of Experience</p>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item reveal" style="transition-delay: 0.2s;">
        <h3 class="stat-number">2012</h3>
        <p class="stat-label text-eyebrow">Established</p>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item reveal" style="transition-delay: 0.4s;">
        <h3 class="stat-number">15+</h3>
        <p class="stat-label text-eyebrow">Major Projects</p>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-section {
    background-color: var(--c-soft-white);
  }

  .stats-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .stats-grid {
      flex-direction: row;
      justify-content: space-around;
      gap: 2rem;
    }
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 300;
    color: var(--c-charcoal);
    margin-bottom: 0.5rem;
  }

  .stat-label {
    color: var(--c-grey);
  }

  .stat-divider {
    display: none;
  }

  @media (min-width: 768px) {
    .stat-divider {
      display: block;
      width: 1px;
      height: 80px;
      background-color: var(--c-grey-light);
    }
  }
</style>
