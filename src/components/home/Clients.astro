---
import { clients } from '../../data/clients';
---

<section class="clients-section section-pad">
  <div class="container">
    <div class="section-header reveal" style="text-align: center;">
      <span class="text-eyebrow">05 / Our Network</span>
      <h2 class="text-h2">Trusted By</h2>
      <span class="section-header__line" style="margin: 1.25rem auto 0;"></span>
    </div>
  </div>

  <div class="marquee-wrapper reveal-scale" style="transition-delay: 0.15s;">
    <div class="marquee-fade marquee-fade--left"></div>
    <div class="marquee-fade marquee-fade--right"></div>
    <div class="clients-marquee">
      <div class="marquee-content">
        {clients.map((client) => (
          <div class="client-logo-wrapper">
            {client.logo ? (
              <img src={client.logo} alt={client.name} class="client-logo" loading="lazy" />
            ) : (
              <span class="client-name">{client.name}</span>
            )}
          </div>
        ))}
        {clients.map((client) => (
          <div class="client-logo-wrapper" aria-hidden="true">
            {client.logo ? (
              <img src={client.logo} alt="" class="client-logo" loading="lazy" />
            ) : (
              <span class="client-name">{client.name}</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .clients-section {
    background-color: var(--c-soft-white);
    overflow: hidden;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-header .text-h2 {
    margin-top: 0.75rem;
  }

  .marquee-wrapper {
    position: relative;
    width: 100%;
  }

  .marquee-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-fade--left {
    left: 0;
    background: linear-gradient(to right, var(--c-soft-white), transparent);
  }

  .marquee-fade--right {
    right: 0;
    background: linear-gradient(to left, var(--c-soft-white), transparent);
  }

  .clients-marquee {
    overflow: hidden;
    padding: 1rem 0;
  }

  .marquee-content {
    display: flex;
    align-items: center;
    gap: 4rem;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee-content:hover {
    animation-play-state: paused;
  }

  .client-logo-wrapper {
    flex-shrink: 0;
    height: 65px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .client-logo {
    width: auto;
    height: 100%;
    max-width: 240px;
    object-fit: contain;
    opacity: 0.5;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    
    /* Light mode */
    mix-blend-mode: multiply;
    filter: grayscale(100%);
  }

  .client-logo:hover {
    transform: translateY(-4px) scale(1.05);
    opacity: 1;
  }

  :global([data-theme="dark"]) .client-logo {
    mix-blend-mode: screen;
    filter: grayscale(100%) invert(1) brightness(200%);
  }

  .client-name {
    font-size: 0.9rem;
    text-align: center;
    color: var(--c-text);
    font-weight: 500;
    font-family: var(--font-heading);
    letter-spacing: 0.05em;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .client-logo-wrapper:hover .client-name {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .client-logo-wrapper {
      height: 45px;
    }

    .marquee-fade {
      width: 60px;
    }
  }
</style>
