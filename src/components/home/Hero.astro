---
import { siteData } from '../../data/site';

const slides = [
  {
    image: "/images/slider1.jpg",
    title: "We Trusted in <br/><span class='text-accent'>Quality</span>",
    button: "EXPLORE OUR EXPERIENCE",
    link: "/experience"
  },
  {
    image: "/images/CITY-GREEN-VIEW.jpg",
    title: "Road to <span class='text-accent'>SUCCESS</span> <br/>is always under <span class='text-accent'>CONSTRUCTION</span>",
    button: "VIEW OUR PROJECTS",
    link: "/projects"
  },
  {
    image: "/images/slider3.jpg",
    title: "<span class='text-accent'>Quality</span> is not an Act, <br/>but it is a habit",
    button: "DISCOVER OUR SERVICES",
    link: "/services"
  },
  {
    image: "/images/slider4.jpg",
    title: "Wonderful things are Achieved <br/>with strong <span class='text-accent'>Team work</span>",
    button: "MEET OUR TEAM",
    link: "/about"
  }
];
---

<section class="hero">
  <!-- Slider Backgrounds -->
  <div class="hero-slider">
    {slides.map((slide, index) => (
      <div class={`hero-slide ${index === 0 ? 'active' : ''}`}>
        <div class="hero-image-container">
          <img src={slide.image} alt={`Sri Lakshmi Construction Banner ${index + 1}`} class="hero-image" />
          <div class="hero-overlay"></div>
        </div>
        
        <!-- Individual Slide Content -->
        <div class="container hero-content">
          <div class="hero-text">
            <h2 class="text-eyebrow">{siteData.name}</h2>
            <h1 class="text-huge hero-title" set:html={slide.title}></h1>
            
            <div class="hero-actions">
              <a href={slide.link} class="btn btn-primary magnetic-btn">{slide.button}</a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
  
  <!-- Slider Controls (Dots) -->
  <div class="slider-controls">
    {slides.map((_, index) => (
      <button class={`slider-dot ${index === 0 ? 'active' : ''}`} data-index={index} aria-label={`Go to slide ${index + 1}`}></button>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    padding-top: var(--header-height);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-slider {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 1;
    transition: opacity 1.5s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-slide.active {
    opacity: 1;
    z-index: 2;
  }

  .hero-image-container {
    position: absolute;
    top: 5%;
    left: 5%;
    width: 90%;
    height: 90%;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    z-index: -1;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1);
    transition: transform 10s ease-out;
  }

  .hero-slide.active .hero-image {
    transform: scale(1);
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.3) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: var(--space-xl) 5%;
    width: 100%;
    display: flex;
    justify-content: center;
    transform: translateY(20px);
    opacity: 0;
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s;
  }

  .hero-slide.active .hero-content {
    transform: translateY(0);
    opacity: 1;
  }

  .hero-text {
    max-width: 1200px;
    width: 100%;
    color: var(--c-white);
    text-align: center;
    margin: 0 auto;
  }

  .text-eyebrow {
    color: var(--c-off-white);
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
    letter-spacing: 0.1em;
  }

  .hero-title {
    margin-bottom: 3rem;
    line-height: 1.15;
    font-size: clamp(3rem, 7vw, 6rem);
  }

  /* Slider Controls */
  .slider-controls {
    position: absolute;
    bottom: 5%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1rem;
    z-index: 10;
  }

  .slider-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.3);
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .slider-dot:hover {
    background-color: rgba(255, 255, 255, 0.7);
  }

  .slider-dot.active {
    background-color: transparent;
    border-color: var(--c-accent);
    transform: scale(1.3);
  }
  
  @media (max-width: 768px) {
    .hero-image-container {
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border-radius: 0;
    }
    
    .slider-controls {
      bottom: 2rem;
    }
  }
</style>

<style is:global>
  .hero-title .text-accent {
    color: var(--c-accent);
    font-style: italic;
    font-weight: 300;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    let currentSlide = 0;
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.slider-dot');
    const totalSlides = slides.length;
    
    if (totalSlides > 1) {
      const goToSlide = (index) => {
        slides.forEach(slide => slide.classList.remove('active'));
        dots.forEach(dot => dot.classList.remove('active'));
        
        slides[index].classList.add('active');
        dots[index].classList.add('active');
        currentSlide = index;
      };
      
      const nextSlide = () => {
        const next = (currentSlide + 1) % totalSlides;
        goToSlide(next);
      };
      
      let slideInterval = setInterval(nextSlide, 5000);
      
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          clearInterval(slideInterval);
          goToSlide(index);
          slideInterval = setInterval(nextSlide, 5000);
        });
      });
    }
  });
</script>
