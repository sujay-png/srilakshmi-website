---
import { services } from '../../data/services';
---

<section class="services-section section-pad">
  <div class="container">
    <div class="section-header section-header--split reveal">
      <div class="section-header__left">
        <span class="text-eyebrow">02 / Expertise</span>
        <h2 class="text-h2">What We Do</h2>
        <span class="section-header__line"></span>
      </div>
      <div class="section-header__right">
        <p class="section-desc">From concept to completion, we deliver construction excellence across every sector.</p>
      </div>
    </div>

    <div class="services-list" id="services-list">
      {services.slice(0, 5).map((service, index) => (
        <a
          href="/services"
          class="service-row interactive reveal"
          data-service-index={index}
          data-image={service.image}
          style={`transition-delay: ${index * 0.08}s;`}
        >
          <div class="service-row__inner">
            <div class="service-number">0{index + 1}</div>
            <div class="service-title-wrap">
              <h3 class="service-title text-h3">{service.title}</h3>
              <p class="service-desc">{service.description}</p>
            </div>
            <div class="service-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Single shared hover image — moved to body via JS -->
    <div class="service-hover-image" id="service-hover-image" aria-hidden="true">
      <img src="" alt="" draggable="false" />
    </div>

    <div class="services-footer reveal" style="transition-delay: 0.4s;">
      <a href="/services" class="btn btn-outline magnetic-btn">
        VIEW ALL SERVICES
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--c-white);
    position: relative;
  }

  .section-header .text-h2 {
    margin-top: 0.75rem;
  }

  .services-list {
    border-top: 1px solid var(--c-grey-light);
    position: relative;
  }

  .service-row.reveal {
    opacity: 0;
    transform: none;
    transition: opacity 0.8s var(--ease-out-expo);
  }

  .service-row.reveal.active {
    opacity: 1;
    transform: none;
  }

  .service-row {
    display: block;
    border-bottom: 1px solid var(--c-grey-light);
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .service-row.is-hovered {
    z-index: 20;
  }

  .service-row__inner {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 1rem;
    position: relative;
    min-height: 76px;
    transition: background-color 0.35s var(--ease-out-expo);
  }

  .service-row.is-hovered .service-row__inner,
  .service-row:hover .service-row__inner {
    background-color: var(--c-soft-white);
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--c-grey);
    transition: color 0.3s ease;
    font-variant-numeric: tabular-nums;
    position: relative;
    z-index: 2;
  }

  .service-row.is-hovered .service-number,
  .service-row:hover .service-number {
    color: var(--c-accent);
  }

  .service-title-wrap {
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  .service-title {
    margin: 0;
    font-size: clamp(1.15rem, 2.5vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    display: inline;
    background-image: linear-gradient(var(--c-saffron), var(--c-saffron));
    background-size: 0% 2px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.4s var(--ease-out-expo);
  }

  .service-row.is-hovered .service-title,
  .service-row:hover .service-title {
    background-size: 100% 2px;
  }

  .service-desc {
    display: none;
  }

  .service-arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--c-grey-light);
    transition: all 0.4s var(--ease-out-expo);
    flex-shrink: 0;
    background: var(--c-white);
    position: relative;
    z-index: 2;
  }

  .service-row.is-hovered .service-arrow,
  .service-row:hover .service-arrow {
    background-color: var(--c-saffron);
    color: var(--c-on-saffron);
    border-color: var(--c-saffron);
    transform: rotate(-45deg);
  }

  .services-footer {
    margin-top: 3rem;
    display: flex;
    justify-content: flex-end;
  }

  @media (min-width: 1024px) {
    .service-row__inner {
      grid-template-columns: 56px 1fr auto;
      gap: 1.5rem;
      padding: 1.5rem 1.25rem;
      min-height: 84px;
    }
  }

  @media (max-width: 1023px) {
    .service-desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 0.8rem;
      color: var(--c-grey);
      line-height: 1.5;
      margin-top: 0.35rem;
    }
  }

  @media (max-width: 768px) {
    .service-row__inner {
      grid-template-columns: 36px 1fr auto;
      gap: 0.75rem;
      padding: 1.15rem 0.75rem;
      min-height: auto;
    }

    .service-arrow {
      width: 34px;
      height: 34px;
    }

    .services-footer {
      justify-content: center;
    }
  }
</style>

<style is:global>
  .service-hover-image {
    position: fixed;
    top: 0;
    left: 0;
    width: 260px;
    height: 260px;
    pointer-events: none;
    z-index: 150;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -50%);
    transition: opacity 0.25s var(--ease-out-expo), visibility 0.25s;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
  }

  .service-hover-image.visible {
    opacity: 1;
    visibility: visible;
  }

  .service-hover-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 1023px) {
    .service-hover-image {
      display: none !important;
    }
  }
</style>

<script>
  if (window.matchMedia('(pointer: fine)').matches && window.innerWidth >= 1024) {
    const preview = document.getElementById('service-hover-image');
    const img = preview?.querySelector('img') as HTMLImageElement;
    const rows = document.querySelectorAll('.service-row[data-image]');

    if (preview && img) {
      document.body.appendChild(preview);

      let activeRow: HTMLElement | null = null;
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let isActive = false;
      let rafId: number;

      const lerp = (start: number, end: number, factor: number) => start + (end - start) * factor;

      const clampToRow = (clientX: number, clientY: number, row: HTMLElement) => {
        const rect = row.getBoundingClientRect();
        return {
          x: Math.max(rect.left, Math.min(rect.right, clientX)),
          y: Math.max(rect.top, Math.min(rect.bottom, clientY)),
        };
      };

      const animate = () => {
        currentX = lerp(currentX, targetX, 0.18);
        currentY = lerp(currentY, targetY, 0.18);
        preview.style.left = `${currentX}px`;
        preview.style.top = `${currentY}px`;

        if (isActive) {
          rafId = requestAnimationFrame(animate);
        }
      };

      const setPosition = (clientX: number, clientY: number) => {
        if (!activeRow) return;
        const pos = clampToRow(clientX, clientY, activeRow);
        targetX = pos.x;
        targetY = pos.y;
      };

      rows.forEach(row => {
        const el = row as HTMLElement;

        el.addEventListener('mouseenter', (e: MouseEvent) => {
          activeRow = el;
          isActive = true;
          el.classList.add('is-hovered');

          const imageSrc = el.dataset.image;
          if (imageSrc) img.src = imageSrc;

          const pos = clampToRow(e.clientX, e.clientY, el);
          targetX = pos.x;
          targetY = pos.y;
          currentX = targetX;
          currentY = targetY;
          preview.style.left = `${currentX}px`;
          preview.style.top = `${currentY}px`;
          preview.classList.add('visible');
          animate();
        });

        el.addEventListener('mousemove', (e: MouseEvent) => {
          if (activeRow === el) setPosition(e.clientX, e.clientY);
        });

        el.addEventListener('mouseleave', () => {
          if (activeRow === el) {
            isActive = false;
            activeRow = null;
            el.classList.remove('is-hovered');
            cancelAnimationFrame(rafId);
            preview.classList.remove('visible');
          }
        });
      });
    }
  }
</script>
