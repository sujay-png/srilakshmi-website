---
import { services } from '../../data/services';
---

<section class="services-section section-pad">
  <div class="container">
    <div class="section-header reveal">
      <span class="text-eyebrow">02 / Expertise</span>
      <h2 class="text-h2">What We Do</h2>
    </div>

    <div class="services-list">
      {services.slice(0, 5).map((service, index) => (
        <a href="/services" class="service-row interactive reveal" style={`transition-delay: ${index * 0.1}s;`}>
          <div class="service-number">0{index + 1}</div>
          <div class="service-title-wrap">
            <h3 class="service-title text-h3">{service.title}</h3>
          </div>
          <div class="service-arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="service-image-preview">
            <img src={service.image} alt={service.title} />
          </div>
        </a>
      ))}
    </div>
    
    <div class="services-footer reveal" style="transition-delay: 0.5s; margin-top: 3rem; text-align: right;">
      <a href="/services" class="btn btn-outline magnetic-btn">VIEW ALL SERVICES</a>
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--c-white);
  }

  .section-header {
    margin-bottom: 4rem;
  }

  .section-header .text-h2 {
    margin-top: 1rem;
  }

  .services-list {
    border-top: 1px solid var(--c-grey-light);
  }

  .service-row {
    display: flex;
    align-items: center;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--c-grey-light);
    position: relative;
    group: hover;
    transition: padding 0.4s ease, background-color 0.4s ease;
  }

  .service-row:hover {
    padding-left: 2rem;
    padding-right: 2rem;
    background-color: var(--c-soft-white);
    border-radius: var(--radius-lg);
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--c-grey);
    width: 60px;
    transition: color 0.3s ease;
  }

  .service-row:hover .service-number {
    color: var(--c-charcoal);
  }

  .service-title-wrap {
    flex-grow: 1;
  }

  .service-title {
    margin: 0;
    transition: transform 0.4s ease;
  }

  .service-row:hover .service-title {
    transform: translateX(10px);
  }

  .service-arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--c-grey-light);
    transition: all 0.4s ease;
  }

  .service-row:hover .service-arrow {
    background-color: var(--c-charcoal);
    color: var(--c-white);
    border-color: var(--c-charcoal);
    transform: translateX(-10px);
  }
  
  .service-image-preview {
    position: absolute;
    right: 15%;
    top: 50%;
    transform: translateY(-50%) scale(0.8) rotate(-5deg);
    width: 300px;
    height: 200px;
    border-radius: var(--radius-md);
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  
  .service-image-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .service-row:hover .service-image-preview {
      opacity: 1;
      transform: translateY(-50%) scale(1) rotate(2deg);
    }
  }

  @media (max-width: 768px) {
    .service-row {
      padding: 1.5rem 0;
    }
    
    .service-row:hover {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    
    .service-number {
      width: 40px;
    }
    
    .service-title {
      font-size: 1.25rem;
    }
  }
</style>
