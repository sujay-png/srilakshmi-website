---
import { services } from '../../data/services';
---

<section class="services-section section-pad">
  <div class="container">
    <div class="section-header section-header--split reveal">
      <div class="section-header__left">
        <span class="text-eyebrow">02 / Expertise</span>
        <h2 class="text-h2">What We Do</h2>
        <span class="section-header__line"></span>
      </div>
      <div class="section-header__right">
        <p class="section-desc">From concept to completion, we deliver construction excellence across every sector.</p>
      </div>
    </div>

    <div class="services-list" id="services-list">
      {services.slice(0, 5).map((service, index) => (
        <a href="/services" class="service-row interactive reveal" data-service-index={index} style={`transition-delay: ${index * 0.08}s;`}>
          <div class="service-row__inner">
            <div class="service-number">0{index + 1}</div>
            <div class="service-title-wrap">
              <h3 class="service-title text-h3">{service.title}</h3>
              <p class="service-desc">{service.description}</p>
            </div>
            <div class="service-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          <div class="service-image-preview" aria-hidden="true">
            <img src={service.image} alt="" loading="lazy" draggable="false" />
          </div>
        </a>
      ))}
    </div>

    <div class="services-footer reveal" style="transition-delay: 0.4s;">
      <a href="/services" class="btn btn-outline magnetic-btn">
        VIEW ALL SERVICES
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--c-white);
    position: relative;
  }

  .section-header .text-h2 {
    margin-top: 0.75rem;
  }

  .services-list {
    border-top: 1px solid var(--c-grey-light);
    position: relative;
  }

  /* Override global .reveal transform — it breaks position context for hover image */
  .service-row.reveal {
    opacity: 0;
    transform: none;
    transition: opacity 0.8s var(--ease-out-expo);
  }

  .service-row.reveal.active {
    opacity: 1;
    transform: none;
  }

  .service-row {
    display: block;
    border-bottom: 1px solid var(--c-grey-light);
    position: relative;
    text-decoration: none;
    color: inherit;
    overflow: visible;
  }

  .service-row:hover {
    z-index: 20;
  }

  .service-row__inner {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 1rem;
    position: relative;
    z-index: 2;
    min-height: 76px;
    transition: background-color 0.35s var(--ease-out-expo);
  }

  .service-row:hover .service-row__inner {
    background-color: var(--c-soft-white);
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--c-grey);
    transition: color 0.3s ease;
    font-variant-numeric: tabular-nums;
  }

  .service-row:hover .service-number {
    color: var(--c-accent);
  }

  .service-title-wrap {
    min-width: 0;
    position: relative;
    z-index: 3;
  }

  .service-title {
    margin: 0;
    font-size: clamp(1.15rem, 2.5vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    display: inline;
    background-image: linear-gradient(var(--c-accent), var(--c-accent));
    background-size: 0% 2px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.4s var(--ease-out-expo);
  }

  .service-row:hover .service-title {
    background-size: 100% 2px;
  }

  .service-desc {
    display: none;
  }

  .service-arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--c-grey-light);
    transition: all 0.4s var(--ease-out-expo);
    flex-shrink: 0;
    background: var(--c-white);
    position: relative;
    z-index: 3;
  }

  .service-row:hover .service-arrow {
    background-color: var(--c-charcoal);
    color: var(--c-white);
    border-color: var(--c-charcoal);
    transform: rotate(-45deg);
  }

  /* Square preview — absolute inside row, follows cursor, center clamped to row */
  .service-image-preview {
    position: absolute;
    top: 0;
    left: 0;
    width: 260px;
    height: 260px;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s var(--ease-out-expo), visibility 0.3s;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
  }

  .service-image-preview.visible {
    opacity: 1;
    visibility: visible;
  }

  .service-image-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .services-footer {
    margin-top: 3rem;
    display: flex;
    justify-content: flex-end;
  }

  @media (min-width: 1024px) {
    .service-row__inner {
      grid-template-columns: 56px 1fr auto;
      gap: 1.5rem;
      padding: 1.5rem 1.25rem;
      min-height: 84px;
    }
  }

  @media (max-width: 1023px) {
    .service-image-preview {
      display: none;
    }

    .service-desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 0.8rem;
      color: var(--c-grey);
      line-height: 1.5;
      margin-top: 0.35rem;
    }
  }

  @media (max-width: 768px) {
    .service-row__inner {
      grid-template-columns: 36px 1fr auto;
      gap: 0.75rem;
      padding: 1.15rem 0.75rem;
      min-height: auto;
    }

    .service-arrow {
      width: 34px;
      height: 34px;
    }

    .services-footer {
      justify-content: center;
    }
  }
</style>

<script>
  if (window.matchMedia('(pointer: fine)').matches && window.innerWidth >= 1024) {
    const rows = document.querySelectorAll('.service-row');

    rows.forEach(row => {
      const preview = row.querySelector('.service-image-preview') as HTMLElement;
      if (!preview) return;

      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let isHovering = false;
      let rafId: number;

      const lerp = (start: number, end: number, factor: number) => start + (end - start) * factor;

      /** Convert cursor to row-local coords; clamp center inside row bounds */
      const getClampedPosition = (clientX: number, clientY: number) => {
        const rect = row.getBoundingClientRect();
        const localX = clientX - rect.left;
        const localY = clientY - rect.top;

        return {
          x: Math.max(0, Math.min(rect.width, localX)),
          y: Math.max(0, Math.min(rect.height, localY)),
        };
      };

      const animate = () => {
        currentX = lerp(currentX, targetX, 0.18);
        currentY = lerp(currentY, targetY, 0.18);

        preview.style.left = `${currentX}px`;
        preview.style.top = `${currentY}px`;

        if (isHovering) {
          rafId = requestAnimationFrame(animate);
        }
      };

      row.addEventListener('mouseenter', (e: MouseEvent) => {
        isHovering = true;
        const pos = getClampedPosition(e.clientX, e.clientY);
        targetX = pos.x;
        targetY = pos.y;
        currentX = targetX;
        currentY = targetY;
        preview.style.left = `${currentX}px`;
        preview.style.top = `${currentY}px`;
        preview.classList.add('visible');
        animate();
      });

      row.addEventListener('mousemove', (e: MouseEvent) => {
        const pos = getClampedPosition(e.clientX, e.clientY);
        targetX = pos.x;
        targetY = pos.y;
      });

      row.addEventListener('mouseleave', () => {
        isHovering = false;
        cancelAnimationFrame(rafId);
        preview.classList.remove('visible');
      });
    });
  }
</script>
