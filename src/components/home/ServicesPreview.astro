---
import { services } from '../../data/services';
---

<section class="services-section section-pad">
  <div class="container">
    <div class="section-header section-header--split reveal">
      <div class="section-header__left">
        <span class="text-eyebrow">02 / Expertise</span>
        <h2 class="text-h2">What We Do</h2>
        <span class="section-header__line"></span>
      </div>
      <div class="section-header__right">
        <p class="section-desc">From concept to completion, we deliver construction excellence across every sector.</p>
      </div>
    </div>

    <div class="services-list" id="services-list">
      {services.slice(0, 5).map((service, index) => (
        <a href="/services" class="service-row interactive reveal" data-service-index={index} style={`transition-delay: ${index * 0.08}s;`}>
          <div class="service-row__inner">
            <div class="service-number">0{index + 1}</div>
            <div class="service-title-wrap">
              <h3 class="service-title text-h3">{service.title}</h3>
              <p class="service-desc">{service.description}</p>
            </div>
            <div class="service-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="service-image-preview" aria-hidden="true">
              <div class="service-image-inner">
                <img src={service.image} alt="" loading="lazy" draggable="false" />
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="services-footer reveal" style="transition-delay: 0.4s;">
      <a href="/services" class="btn btn-outline magnetic-btn">
        VIEW ALL SERVICES
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--c-white);
    position: relative;
  }

  .section-header .text-h2 {
    margin-top: 0.75rem;
  }

  .services-list {
    border-top: 1px solid var(--c-grey-light);
  }

  .service-row {
    display: block;
    border-bottom: 1px solid var(--c-grey-light);
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .service-row__inner {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1rem;
    position: relative;
    overflow: hidden;
    min-height: 72px;
    border-radius: var(--radius-md);
    transition: background-color 0.4s var(--ease-out-expo);
  }

  .service-row:hover .service-row__inner {
    background-color: var(--c-soft-white);
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--c-grey);
    transition: color 0.3s ease;
    font-variant-numeric: tabular-nums;
    position: relative;
    z-index: 2;
  }

  .service-row:hover .service-number {
    color: var(--c-accent);
  }

  .service-title-wrap {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .service-title {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    transition: transform 0.4s var(--ease-out-expo);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .service-desc {
    display: none;
  }

  .service-row:hover .service-title {
    transform: translateX(6px);
  }

  .service-arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--c-grey-light);
    transition: all 0.4s var(--ease-out-expo);
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    background: var(--c-white);
  }

  .service-row:hover .service-arrow {
    background-color: var(--c-charcoal);
    color: var(--c-white);
    border-color: var(--c-charcoal);
    transform: rotate(-45deg);
  }

  /* Image stays inside the row */
  .service-image-preview {
    position: absolute;
    top: 50%;
    left: 55%;
    width: 180px;
    height: 110px;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -50%) scale(0.9);
    transition: opacity 0.35s var(--ease-out-expo), visibility 0.35s, transform 0.12s var(--ease-out-expo);
    will-change: transform, left, top;
  }

  .service-image-preview.visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .service-image-inner {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    border: 2px solid var(--c-white);
  }

  .service-image-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .services-footer {
    margin-top: 3rem;
    display: flex;
    justify-content: flex-end;
  }

  @media (min-width: 1024px) {
    .service-row__inner {
      grid-template-columns: 56px 1fr auto;
      gap: 1.5rem;
      padding: 1.35rem 1.5rem;
      min-height: 80px;
    }

    .service-image-preview {
      width: 200px;
      height: 120px;
    }
  }

  @media (max-width: 1023px) {
    .service-image-preview {
      display: none;
    }

    /* Show description on tablet/mobile instead of hover image */
    .service-desc {
      display: block;
      font-size: 0.8rem;
      color: var(--c-grey);
      line-height: 1.5;
      margin-top: 0.35rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .service-title {
      white-space: normal;
    }
  }

  @media (max-width: 768px) {
    .service-row__inner {
      grid-template-columns: 36px 1fr auto;
      gap: 0.75rem;
      padding: 1.1rem 0.75rem;
      min-height: auto;
    }

    .service-arrow {
      width: 34px;
      height: 34px;
    }

    .services-footer {
      justify-content: center;
    }

    .section-header--split {
      gap: 1rem;
    }
  }
</style>

<script>
  if (window.matchMedia('(pointer: fine)').matches && window.innerWidth >= 1024) {
    const rows = document.querySelectorAll('.service-row');

    rows.forEach(row => {
      const inner = row.querySelector('.service-row__inner') as HTMLElement;
      const preview = row.querySelector('.service-image-preview') as HTMLElement;
      if (!inner || !preview) return;

      const imgW = 200;
      const imgH = 120;
      const arrowSpace = 56;

      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let isHovering = false;
      let rafId: number;

      const lerp = (start: number, end: number, factor: number) => start + (end - start) * factor;

      const clampPosition = (x: number, y: number, rect: DOMRect) => {
        const padX = imgW / 2 + 12;
        const padY = imgH / 2 + 8;
        const minX = padX;
        const maxX = rect.width - padX - arrowSpace;
        const minY = padY;
        const maxY = rect.height - padY;

        return {
          x: Math.max(minX, Math.min(maxX, x)),
          y: Math.max(minY, Math.min(maxY, y)),
        };
      };

      const animate = () => {
        currentX = lerp(currentX, targetX, 0.14);
        currentY = lerp(currentY, targetY, 0.14);

        preview.style.left = `${currentX}px`;
        preview.style.top = `${currentY}px`;

        if (isHovering) {
          rafId = requestAnimationFrame(animate);
        }
      };

      row.addEventListener('mouseenter', (e: MouseEvent) => {
        isHovering = true;
        const rect = inner.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const clamped = clampPosition(x, y, rect);
        targetX = clamped.x;
        targetY = clamped.y;
        currentX = targetX;
        currentY = targetY;
        preview.style.left = `${currentX}px`;
        preview.style.top = `${currentY}px`;
        preview.classList.add('visible');
        animate();
      });

      row.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = inner.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const clamped = clampPosition(x, y, rect);
        targetX = clamped.x;
        targetY = clamped.y;
      });

      row.addEventListener('mouseleave', () => {
        isHovering = false;
        cancelAnimationFrame(rafId);
        preview.classList.remove('visible');
      });
    });
  }
</script>
