---
import { services } from '../../data/services';
---

<section class="services-section section-pad">
  <div class="container">
    <div class="section-header section-header--split reveal">
      <div class="section-header__left">
        <span class="text-eyebrow">02 / Expertise</span>
        <h2 class="text-h2">What We Do</h2>
        <span class="section-header__line"></span>
      </div>
      <div class="section-header__right">
        <p class="section-desc">From concept to completion, we deliver construction excellence across every sector.</p>
      </div>
    </div>

    <div class="services-list" id="services-list">
      {services.slice(0, 6).map((service, index) => (
        <a
          href="/services"
          class="service-row interactive reveal"
          data-service-index={index}
          style={`transition-delay: ${index * 0.08}s;`}
        >
          <div class="service-row__inner">
            <div class="service-number">0{index + 1}</div>
            <div class="service-title-wrap">
              <h3 class="service-title text-h3">{service.title}</h3>
              <p class="service-desc">{service.description}</p>
            </div>
            
            <div class="service-image-inline">
              <img src={service.image} alt={service.title} loading="lazy" />
            </div>

            <div class="service-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="services-footer reveal" style="transition-delay: 0.4s;">
      <a href="/services" class="btn btn-outline magnetic-btn">
        VIEW ALL SERVICES
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--c-white);
    position: relative;
  }

  .section-header .text-h2 {
    margin-top: 0.75rem;
  }

  .services-list {
    border-top: 1px solid var(--c-grey-light);
    position: relative;
  }

  .service-row.reveal {
    opacity: 0;
    transform: none;
    transition: opacity 0.8s var(--ease-out-expo);
  }

  .service-row.reveal.active {
    opacity: 1;
    transform: none;
  }

  .service-row {
    display: block;
    border-bottom: 1px solid var(--c-grey-light);
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .service-row.is-hovered {
    z-index: 20;
  }

  .service-row__inner {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 1rem;
    position: relative;
    min-height: 76px;
    transition: background-color 0.35s var(--ease-out-expo);
  }

  .service-row.is-hovered .service-row__inner,
  .service-row:hover .service-row__inner {
    background-color: var(--c-soft-white);
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--c-grey);
    transition: color 0.3s ease;
    font-variant-numeric: tabular-nums;
    position: relative;
    z-index: 2;
  }

  .service-row.is-hovered .service-number,
  .service-row:hover .service-number {
    color: var(--c-accent);
  }

  .service-title-wrap {
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  .service-title {
    margin: 0;
    font-size: clamp(1.15rem, 2.5vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    display: inline;
    background-image: linear-gradient(var(--c-saffron), var(--c-saffron));
    background-size: 0% 2px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.4s var(--ease-out-expo);
  }

  .service-row.is-hovered .service-title,
  .service-row:hover .service-title {
    background-size: 100% 2px;
  }

  .service-desc {
    display: none;
  }

  .service-arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--c-grey-light);
    transition: all 0.4s var(--ease-out-expo);
    flex-shrink: 0;
    background: var(--c-white);
    position: relative;
    z-index: 2;
  }

  .service-row.is-hovered .service-arrow,
  .service-row:hover .service-arrow {
    background-color: var(--c-saffron);
    color: var(--c-on-saffron);
    border-color: var(--c-saffron);
    transform: rotate(-45deg);
  }

  .service-image-inline {
    display: none;
  }

  .services-footer {
    margin-top: 3rem;
    display: flex;
    justify-content: flex-end;
  }

  @media (min-width: 1024px) {
    .service-row__inner {
      grid-template-columns: 56px 1fr auto;
      gap: 1.5rem;
      padding: 1.5rem 1.25rem;
      min-height: 84px;
    }

    .service-image-inline {
      display: block;
      position: absolute;
      right: 140px;
      top: 50%;
      transform: translateY(-50%);
      width: 240px;
      height: 160px;
      opacity: 0;
      visibility: hidden;
      border-radius: 8px;
      overflow: hidden;
      pointer-events: none;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
      transition: opacity 0.4s var(--ease-out-expo), visibility 0.4s, transform 0.4s var(--ease-out-expo);
      z-index: 10;
    }

    .service-row.is-hovered .service-image-inline,
    .service-row:hover .service-image-inline {
      opacity: 1;
      visibility: visible;
      transform: translateY(-50%) scale(1.02);
    }

    .service-image-inline img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  @media (max-width: 1023px) {
    .service-desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 0.8rem;
      color: var(--c-grey);
      line-height: 1.5;
      margin-top: 0.35rem;
    }
  }

  @media (max-width: 768px) {
    .service-row__inner {
      grid-template-columns: 36px 1fr auto;
      gap: 0.75rem;
      padding: 1.15rem 0.75rem;
      min-height: auto;
    }

    .service-arrow {
      width: 34px;
      height: 34px;
    }

    .services-footer {
      justify-content: center;
    }
  }
</style>

</style>
