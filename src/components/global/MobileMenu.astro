<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-inner">
    <nav class="mobile-nav">
      <ul class="mobile-nav-list">
        <li><a href="/" class="mobile-link">Home</a></li>
        <li><a href="/about" class="mobile-link">About</a></li>
        <li><a href="/services" class="mobile-link">Services</a></li>
        <li><a href="/responsibility" class="mobile-link sub-link">Giving Back &amp; Safety</a></li>
        <li><a href="/projects" class="mobile-link">Projects</a></li>
        <li><a href="/experience" class="mobile-link">Experience</a></li>
        <li><a href="/career" class="mobile-link">Career</a></li>
        <li><a href="/contact" class="mobile-link">Contact</a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--c-charcoal);
    color: var(--c-white);
    z-index: 101;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.77, 0, 0.175, 1);
    /* Rounded overlay effect on open */
    clip-path: circle(0% at 90% 45px);
  }

  .mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
    clip-path: circle(150% at 90% 45px);
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: center;
  }

  .mobile-link {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s ease;
  }

  .mobile-menu.open .mobile-link {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger delays */
  .mobile-menu.open .mobile-nav-list li:nth-child(1) .mobile-link { transition-delay: 0.1s; }
  .mobile-menu.open .mobile-nav-list li:nth-child(2) .mobile-link { transition-delay: 0.15s; }
  .mobile-menu.open .mobile-nav-list li:nth-child(3) .mobile-link { transition-delay: 0.2s; }
  .mobile-menu.open .mobile-nav-list li:nth-child(4) .mobile-link { transition-delay: 0.25s; }
  .mobile-menu.open .mobile-nav-list li:nth-child(5) .mobile-link { transition-delay: 0.3s; }
  .mobile-menu.open .mobile-nav-list li:nth-child(6) .mobile-link { transition-delay: 0.35s; }
  .mobile-menu.open .mobile-nav-list li:nth-child(7) .mobile-link { transition-delay: 0.4s; }
  .mobile-menu.open .mobile-nav-list li:nth-child(8) .mobile-link { transition-delay: 0.45s; }

  @media (max-width: 480px) {
    .mobile-link {
      font-size: 1.75rem;
    }

    .mobile-nav-list {
      gap: 1.25rem;
    }

    .sub-link {
      font-size: 1.1rem !important;
      opacity: 0.7;
    }
  }

</style>

<script>
  const menuBtn = document.querySelector('.mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('open');
      const isOpen = mobileMenu.classList.contains('open');
      menuBtn.setAttribute('aria-expanded', isOpen.toString());
      document.body.style.overflow = isOpen ? 'hidden' : '';
      
      // Animate hamburger lines
      const lines = menuBtn.querySelectorAll('.hamburger-line') as NodeListOf<HTMLElement>;
      if (isOpen) {
        lines[0].style.transform = 'translateY(4px) rotate(45deg)';
        lines[0].style.backgroundColor = '#fff';
        lines[1].style.transform = 'translateY(-4px) rotate(-45deg)';
        lines[1].style.backgroundColor = '#fff';
      } else {
        lines[0].style.transform = 'none';
        lines[0].style.backgroundColor = 'var(--c-charcoal)';
        lines[1].style.transform = 'none';
        lines[1].style.backgroundColor = 'var(--c-charcoal)';
      }
    });
  }
</script>
