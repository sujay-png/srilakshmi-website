---
import { siteData } from '../../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="header" id="main-header">
  <div class="container header-inner">
    <a href="/" class="logo-link">
      <img src="/images/srilakshmiconstructionlogo-1.png" alt={siteData.name} class="logo" />
    </a>
    
    <nav class="desktop-nav">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/about" class="nav-link">About</a></li>
        <li class="has-dropdown">
          <a href="/services" class="nav-link">Services</a>
          <ul class="dropdown">
            <li><a href="/responsibility" class="nav-link">Giving Back &amp; Safety</a></li>
          </ul>
        </li>
        <li><a href="/projects" class="nav-link">Projects</a></li>
        <li><a href="/experience" class="nav-link">Experience</a></li>
        <li><a href="/career" class="nav-link">Career</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <a href="/contact" class="btn btn-primary magnetic-btn">START A PROJECT</a>
      <button class="mobile-menu-btn" aria-label="Open Menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    z-index: 100;
    transition:
      height 0.4s var(--ease-out-expo),
      background-color 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease,
      backdrop-filter 0.4s ease;
    background-color: var(--c-header-bg);
    border-bottom: 1px solid var(--c-header-border);
  }

  .header.scrolled {
    background-color: var(--c-header-bg-scrolled);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid var(--c-header-border);
    box-shadow: 0 4px 24px var(--c-header-shadow);
    height: var(--header-height-scrolled);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo {
    height: 50px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    transition: height 0.4s var(--ease-out-expo), filter 0.3s ease;
  }

  .header.scrolled .logo {
    height: 40px;
  }

  /* Transparent over hero sections (mobile/tablet) */
  @media (max-width: 1023px) {
    .header.over-hero:not(.scrolled) {
      background-color: transparent;
      border-bottom-color: transparent;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .header.over-hero:not(.scrolled) .hamburger-line {
      background-color: var(--c-surface);
      box-shadow: 0 0 8px rgba(0, 0, 0, 0.3);
    }

    .header.over-hero.scrolled .hamburger-line {
      background-color: var(--c-text);
      box-shadow: none;
    }
  }

  @media (max-width: 1023px) {
    .header {
      height: var(--header-height-mobile);
    }

    .header.scrolled {
      height: var(--header-height-mobile-scrolled);
    }

    .logo {
      height: 34px;
      max-width: 130px;
    }

    .header.scrolled .logo {
      height: 30px;
    }

    .header-inner {
      padding: 0;
    }
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    gap: 2rem;
  }

  .nav-list > li {
    position: relative;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background-color: var(--c-surface);
    min-width: 200px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    border: 1px solid var(--c-grey-light);
    border-radius: var(--radius-sm);
    padding: 1rem 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.3s ease;
    z-index: 10;
  }

  .has-dropdown:hover .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown li {
    padding: 0 1.5rem;
  }

  .dropdown .nav-link {
    display: block;
    padding: 0.75rem 0;
    color: var(--c-text);
  }

  .dropdown .nav-link::after {
    display: none;
  }
  
  .dropdown .nav-link:hover {
    color: var(--c-accent);
  }

  .nav-link {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    padding: 0.5rem 0;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--c-text);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after, .nav-link.active::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-actions .btn {
    display: none;
  }

  @media (min-width: 1024px) {
    .header-actions .btn {
      display: inline-flex;
      padding: 0.75rem 1.5rem;
      font-size: 0.875rem;
    }
  }

  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 28px;
    height: 28px;
    justify-content: center;
    align-items: center;
    z-index: 102;
    padding: 4px;
  }

  @media (min-width: 1024px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--c-text);
    border-radius: 1px;
    transition: all 0.3s ease;
  }
</style>

<script>
  const header = document.getElementById('main-header');

  if (header) {
    const firstSection = document.querySelector('main > section:first-child, main > :first-child');
    if (
      firstSection?.classList.contains('page-hero') ||
      firstSection?.classList.contains('hero')
    ) {
      header.classList.add('over-hero');
    }

    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 20);
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const currentPath = window.location.pathname;
  document.querySelectorAll('.nav-link').forEach(link => {
    const href = link.getAttribute('href');
    if (href === currentPath || (currentPath !== '/' && href?.startsWith(currentPath))) {
      link.classList.add('active');
    }
  });
</script>
