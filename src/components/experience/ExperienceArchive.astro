---
import { projects } from '../../data/projects';
---

<section class="experience-archive section-pad section-muted">
  <div class="container">
    <div class="section-header section-header--split reveal">
      <div class="section-header__left">
        <span class="text-eyebrow">Visual Archive</span>
        <h2 class="text-h2">A Legacy in<br/>Every Structure</h2>
        <span class="section-header__line"></span>
      </div>
      <div class="section-header__right">
        <p class="section-desc">Over a decade of landmark projects across residential, educational, commercial, and religious architecture.</p>
      </div>
    </div>

    <div class="archive-grid">
      {projects.map((project, index) => (
        <a
          href={`/projects#${project.id}`}
          class={`archive-item reveal-scale project-card-hover ${index % 5 === 0 ? 'archive-item--large' : ''}`}
          style={`transition-delay: ${(index % 4) * 0.06}s;`}
          data-cursor="VIEW →"
        >
          <div class="archive-item__image">
            <img src={project.image} alt={project.title} loading="lazy" />
            <div class="archive-item__overlay">
              <span class="archive-item__category">{project.category}</span>
            </div>
          </div>
          <div class="archive-item__info">
            <h3 class="archive-item__title">{project.title}</h3>
            <span class="archive-item__location">{project.location}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .archive-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .archive-item {
    display: block;
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--c-white);
    transition: transform 0.6s var(--ease-out-expo), box-shadow 0.6s var(--ease-out-expo);
  }

  .archive-item:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
  }

  .archive-item--large {
    grid-column: span 1;
  }

  @media (min-width: 1024px) {
    .archive-item--large {
      grid-column: span 2;
    }

    .archive-item--large .archive-item__image {
      aspect-ratio: 21/9;
    }
  }

  .archive-item__image {
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--c-grey-light);
  }

  .archive-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out-expo);
  }

  .archive-item:hover .archive-item__image img {
    transform: scale(1.06);
  }

  .archive-item__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-expo);
  }

  .archive-item:hover .archive-item__overlay {
    opacity: 1;
  }

  .archive-item__category {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-white);
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .archive-item__info {
    padding: 1.5rem 1.75rem;
  }

  .archive-item__title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
    color: var(--c-charcoal);
  }

  .archive-item__location {
    font-size: 0.85rem;
    color: var(--c-grey);
  }
</style>
