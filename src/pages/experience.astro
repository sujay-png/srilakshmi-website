---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/global/PageHero.astro';
import ExperienceArchive from '../components/experience/ExperienceArchive.astro';
import ContentSection from '../components/global/ContentSection.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
---

<BaseLayout title="Our Experience">
  <PageHero
    eyebrow="Our Legacy"
    title="A Visual Archive<br/>of Our Experience."
    subtitle="It all started with dreaming of constructing beautiful buildings around the City keeping in mind not to affect the existing ecosystem and having a sustainable growth and opportunity for everyone involved in the project."
    image="/images/slider1.jpg"
    size="large"
  />

  <ContentSection
    eyebrow="Our Mission"
    title="Building With Purpose"
    variant="light"
    maxWidth="720px"
  >
    <p class="text-lead">
      We construct functionally efficient, economically viable complexes that reflect engineering excellence and architectural ambiance.
    </p>
    <p class="text-body">
      Every project we undertake is guided by a commitment to sustainable growth — creating opportunities for everyone involved while preserving the ecosystems of the communities we serve.
    </p>
  </ContentSection>

  <ExperienceArchive />
  <FinalCTA />
</BaseLayout>
