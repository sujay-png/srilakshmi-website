---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/global/PageHero.astro';

export async function getStaticPaths() {
  const res = await fetch('https://dashboard.srilakshmiconstruction.com/wp-json/wp/v2/posts?_embed');
  const posts = await res.json();
  
  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: any;
}

const { post } = Astro.props;
const featuredImage = post._embedded?.['wp:featuredmedia']?.[0]?.source_url || "/images/ASHOKA-PARADISE.jpg";
const plainTitle = post.title.rendered.replace(/<[^>]*>?/gm, '');
---

<BaseLayout title={plainTitle}>
  <PageHero
    eyebrow={new Date(post.date).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric'
    })}
    title={plainTitle}
    image={featuredImage}
    size="large"
  />

  <section class="blog-details section-pad section-light">
    <div class="container blog-container">
      <div class="blog-layout">
        <div class="blog-main">
          <div class="blog-body" set:html={post.content.rendered} />
          
          <div class="blog-footer">
            <a href="/blog/" class="btn btn-primary magnetic-btn">← Back to Blog</a>
          </div>
        </div>
        
        <aside class="blog-sidebar">
          <div class="sidebar-widget cta-widget">
            <h3 class="widget-title">Start Your Project</h3>
            <p class="widget-text">Ready to build something amazing? Let's discuss your next project.</p>
            <a href="/contact/" class="btn btn-primary magnetic-btn">Contact Us</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-container {
    max-width: 1300px;
    margin: 0 auto;
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .blog-layout {
      grid-template-columns: 2.5fr 1fr;
      gap: 4rem;
    }
  }

  .blog-sidebar {
    position: sticky;
    top: calc(var(--header-height, 80px) + 2rem);
    align-self: start;
  }

  .cta-widget {
    background: var(--c-surface);
    padding: 2.5rem 2rem;
    border-radius: var(--radius-md);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    text-align: center;
    border: 1px solid var(--c-border);
  }

  .widget-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--c-text);
    margin-bottom: 1rem;
  }

  .widget-text {
    color: var(--c-text-muted);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .blog-body {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--c-text);
  }

  .blog-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    margin: 3rem 0 1.25rem;
    color: var(--c-text);
    line-height: 1.2;
  }

  .blog-body :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    margin: 2.5rem 0 1rem;
    color: var(--c-text);
    line-height: 1.3;
  }

  .blog-body :global(h4) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin: 2rem 0 1rem;
    color: var(--c-text);
  }

  .blog-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .blog-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: 2.5rem 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .blog-body :global(figure) {
    margin: 2.5rem 0;
  }
  
  .blog-body :global(figcaption) {
    text-align: center;
    font-size: 0.9rem;
    color: var(--c-text-muted);
    margin-top: 0.75rem;
  }

  .blog-body :global(ul), .blog-body :global(ol) {
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }

  .blog-body :global(li) {
    margin-bottom: 0.5rem;
  }
  
  .blog-body :global(blockquote) {
    margin: 2.5rem 0;
    padding: 1.5rem 2rem;
    border-left: 4px solid var(--c-accent);
    background: var(--c-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: 1.25rem;
    font-style: italic;
    color: var(--c-text-muted);
  }
  
  .blog-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .blog-body :global(a) {
    color: var(--c-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
  }

  .blog-body :global(a:hover) {
    color: var(--c-text);
  }

  .blog-footer {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--c-border);
    display: flex;
    justify-content: center;
  }
</style>
