---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/global/PageHero.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import { siteData } from '../data/site';
---

<BaseLayout title="Contact">
  <PageHero
    eyebrow="Start A Project"
    title="Let's Build Something<br/>Exceptional Together."
    image="/images/slider4.jpg"
    size="large"
  />

  <section class="contact-section section-pad section-light">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info reveal-left">
          <span class="text-eyebrow">Get in Touch</span>
          <h2 class="contact-heading">Headquarters</h2>
          <span class="section-header__line"></span>

          <div class="info-blocks">
            <div class="info-block">
              <h4 class="info-label">Address</h4>
              <p class="info-text">{siteData.contact.address}</p>
            </div>

            <div class="info-block">
              <h4 class="info-label">Phone</h4>
              <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="info-link">{siteData.contact.phone}</a>
            </div>

            <div class="info-block">
              <h4 class="info-label">Email</h4>
              <a href={`mailto:${siteData.contact.email}`} class="info-link">{siteData.contact.email}</a>
            </div>
          </div>

          <div class="contact-hours">
            <h4 class="info-label">Office Hours</h4>
            <p class="info-text">Mon – Sat: 9:00 AM – 6:00 PM</p>
          </div>
        </div>

        <div class="contact-form-wrapper reveal-right" style="transition-delay: 0.15s;">
          <form class="contact-form">
            <h3 class="form-heading">Send a Message</h3>
            <p class="form-sub">Tell us about your project and we'll get back to you within 24 hours.</p>

            <div class="form-group">
              <input type="text" id="name" name="name" required placeholder=" " />
              <label for="name">Your Name</label>
            </div>

            <div class="form-group">
              <input type="email" id="email" name="email" required placeholder=" " />
              <label for="email">Your Email</label>
            </div>

            <div class="form-group">
              <textarea id="message" name="message" rows="5" required placeholder=" "></textarea>
              <label for="message">Tell us about your project...</label>
            </div>

            <button type="submit" class="btn btn-primary magnetic-btn form-submit">
              SEND MESSAGE
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </form>
        </div>
      </div>

      <div class="map-section reveal-scale" style="transition-delay: 0.25s;">
        <div class="map-header">
          <span class="text-eyebrow">Find Us</span>
          <h3 class="map-title">Our Location</h3>
        </div>
        <div class="map-wrapper">
          <iframe
            src="https://www.google.com/maps?q=Evershine+complex,+opp+H.P+Petrol+bunk,+Kavoor,+Mangalore,+Karnataka+575015&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            title="Sri Lakshmi Construction location"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 5rem;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .contact-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    margin: 0.75rem 0 0;
    line-height: 1.1;
  }

  .info-blocks {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .info-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.5rem;
  }

  .info-text {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--c-charcoal-light);
  }

  .info-link {
    font-size: 1.05rem;
    color: var(--c-charcoal);
    transition: color 0.3s ease;
    display: inline-block;
  }

  .info-link:hover {
    color: var(--c-accent);
  }

  .contact-hours {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-grey-light);
  }

  .contact-form {
    background: var(--c-inverse-surface);
    color: var(--c-inverse-text);
    padding: 3rem;
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
  }

  .contact-form::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -30%;
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse, var(--c-saffron-soft) 0%, transparent 70%);
    pointer-events: none;
  }

  .form-heading {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
    position: relative;
  }

  .form-sub {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 2rem;
    position: relative;
  }

  .form-group {
    position: relative;
    margin-bottom: 1.75rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.25rem 0 0.5rem;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--c-inverse-text);
    transition: border-color 0.3s ease;
    position: relative;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form-group label {
    position: absolute;
    top: 1rem;
    left: 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
    transition: all 0.3s var(--ease-out-expo);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--c-accent);
  }

  .form-group input:focus ~ label,
  .form-group input:not(:placeholder-shown) ~ label,
  .form-group textarea:focus ~ label,
  .form-group textarea:not(:placeholder-shown) ~ label {
    top: 0;
    font-size: 0.7rem;
    color: var(--c-accent);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .form-submit {
    width: 100%;
    background: var(--c-saffron);
    color: var(--c-on-saffron);
    margin-top: 0.5rem;
    position: relative;
  }

  .form-submit:hover {
    background: var(--c-saffron-hover);
    box-shadow: 0 12px 32px var(--c-saffron-glow);
  }

  .map-section {
    border-top: 1px solid var(--c-grey-light);
    padding-top: 4rem;
  }

  .map-header {
    margin-bottom: 2rem;
  }

  .map-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    margin-top: 0.5rem;
    letter-spacing: -0.02em;
  }

  .map-wrapper {
    width: 100%;
    height: 400px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--c-grey-light);
    filter: grayscale(20%);
    transition: filter 0.5s ease;
  }

  .map-wrapper:hover {
    filter: grayscale(0%);
  }

  @media (max-width: 768px) {
    .contact-form {
      padding: 2rem 1.5rem;
    }

    .contact-info {
      padding: 2rem 1.5rem;
    }

    .map-wrapper {
      height: 280px;
    }

    .contact-grid {
      margin-bottom: 3rem;
    }
  }
</style>
