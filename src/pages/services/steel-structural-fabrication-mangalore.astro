<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Smooth scroll for CTAs targeting the enquiry form
    const scrollLinks = document.querySelectorAll('.scroll-to-form');
    const heroCard = document.getElementById('hero-enquiry-form');

    scrollLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetElement = heroCard || document.querySelector('.enquiry-card');
        if (targetElement) {
          const headerOffset = 100;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });

          // Pulse animation on the card
          targetElement.classList.remove('pulse-highlight');
          void targetElement.offsetWidth; // trigger reflow
          targetElement.classList.add('pulse-highlight');

          // Focus first input
          const firstInput = targetElement.querySelector('input');
          if (firstInput) {
            setTimeout(() => firstInput.focus(), 450);
          }
        }
      });
    });

    // Form submission handling for both enquiry and quote forms
    const forms = document.querySelectorAll('.site-form');
    forms.forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const responseBox = f.querySelector('.form-response') as HTMLElement;
        const submitBtn = f.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalBtnText = submitBtn ? submitBtn.textContent : 'SEND ENQUIRY';

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }
        if (responseBox) {
          responseBox.className = 'form-response';
          responseBox.textContent = '';
        }

        const formData = new FormData(f);
        const data: Record<string, any> = {};
        formData.forEach((value, key) => {
          data[key] = value;
        });

        try {
          const res = await fetch('https://formsubmit.co/ajax/enquires.wrnxt@gmail.com', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(data)
          });

          if (res.ok) {
            if (responseBox) {
              responseBox.className = 'form-response success';
              responseBox.textContent = 'Thank you! Your steel fabrication enquiry has been received. Our engineers will get back to you shortly.';
            }
            if (submitBtn) {
              submitBtn.textContent = 'ENQUIRY SENT ✓';
            }
            f.reset();
          } else {
            throw new Error('Submission failed');
          }
        } catch (err) {
          if (responseBox) {
            responseBox.className = 'form-response error';
            responseBox.textContent = 'There was an issue sending your enquiry. Please try again or call +91 9880138027 directly.';
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalBtnText;
          }
        }
      });
    });
  });
</script>

