              </div>

              <div class="form-field">
                <label for="close-project-type">PROJECT TYPE</label>
                <div class="select-wrapper">
                  <select id="close-project-type" name="project_type" required>
                    <option value="" disabled selected>Select project type</option>
                    <option value="Industrial sheds & factory frames">Industrial sheds &amp; factory frames</option>
                    <option value="Warehouses & storage buildings">Warehouses &amp; storage buildings</option>
                    <option value="Roof trusses & long-span roofs">Roof trusses &amp; long-span roofs</option>
                    <option value="Commercial building frames">Commercial building frames</option>
                    <option value="Mezzanine floors, platforms & staircases">Mezzanine floors, platforms &amp; staircases</option>
                    <option value="Extensions & strengthening">Extensions &amp; strengthening</option>
                    <option value="Other steel structure">Other steel structure</option>
                  </select>
                </div>
              </div>

              <div class="form-field">
                <label for="close-requirements">TELL US ABOUT YOUR DRAWINGS OR REQUIREMENTS</label>
                <textarea id="close-requirements" name="requirements" rows="3" placeholder="Describe your requirements, dimensions, tonnage or timeline..."></textarea>
              </div>

              <button type="submit" class="submit-orange-btn">
