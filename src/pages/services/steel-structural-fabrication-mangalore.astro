---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteData } from '../../data/site';

const pageTitle = "Steel Structural Fabrication Mangalore";
const pageDescription = "We fabricate and erect steel structures for industrial, commercial and institutional buildings across coastal Karnataka. Built with quality, delivered with speed, and backed by experience.";

// Scope - What We Fabricate (02 / SCOPE)
const whatWeFabricate = [
  {
    num: "01",
    title: "Industrial sheds & factory frames",
    desc: "Columns, rafters and bracing for plants and workshops."
  },
  {
    num: "02",
    title: "Warehouses & storage buildings",
    desc: "Wide, open spaces for stock, racking and vehicle movement."
  },
  {
    num: "03",
    title: "Roof trusses & long-span roofs",
    desc: "Steel roofs for showrooms, halls and assembly spaces."
  },
  {
    num: "04",
    title: "Commercial building frames",
    desc: "Steel and composite frames for offices, showrooms and retail buildings."
  },
  {
    num: "05",
    title: "Mezzanine floors, platforms & staircases",
    desc: "Extra floor space without a full rebuild."
  },
  {
    num: "06",
    title: "Extensions & strengthening",
    desc: "Steel additions and supports for existing buildings, a natural fit with our renovation work."
  }
];

// Six-Stage Job Strip (01 / OVERVIEW)
const jobStages = [
  { num: "01", name: "Planning" },
  { num: "02", name: "Fabrication drawings" },
  { num: "03", name: "Workshop fabrication" },
  { num: "04", name: "Coating" },
  { num: "05", name: "Transport" },
  { num: "06", name: "Erection", isHighlight: true }
];

// Who This Is For (03 / WHO THIS IS FOR)
const whoThisIsFor = [
  {
    num: "01",
    title: "Project managers",
    desc: "A clear erection sequence, fabrication drawings and inspection records you can track."
  },
  {
    num: "02",
    title: "Property owners",
    desc: "One accountable team, open updates, and a structure that is easy to extend later."
  },
  {
    num: "03",
    title: "Investors",
    desc: "A faster build can help you start earning sooner, and we compare steel and RCC before you commit."
  },
  {
    num: "04",
    title: "Commercial developers",
    desc: "Design, fabrication and erection under one contract, with one point of contact."
  }
];

// Why Build in Steel (04 / WHY STEEL)
const whySteelReasons = [
  {
    num: "01",
    title: "Faster to build",
    desc: "Steel structures go up faster than RCC and need lighter foundations. Workshop fabrication can run while the foundations are built on site."
  },
  {
    num: "02",
    title: "Lighter foundations",
    desc: "A lighter frame puts less load on the ground, which can reduce foundation work."
  },
  {
    num: "03",
    title: "Wide, open spaces",
    desc: "Steel’s strength-to-weight ratio lets it carry long clear spans efficiently, which suits warehouses and showrooms."
  },
  {
    num: "04",
    title: "Easy to change later",
    desc: "Bolted steel members can be added to or altered when your needs grow."
  },
  {
    num: "05",
    title: "Recyclable",
    desc: "Steel can be recycled, which cuts waste."
  }
];

// Fabrication Process (05 / PROCESS)
const processColumns = [
  {
    phase: "Plan",
    stepRange: "STEPS 1–3",
    steps: [
      {
        num: "01",
        title: "Requirements and site review",
        desc: "We study your needs, loads, spans and site conditions."
      },
      {
        num: "02",
        title: "Design and fabrication drawings",
        desc: "We prepare detailed drawings for every member and connection."
      },
      {
        num: "03",
        title: "Material procurement",
        desc: "We order steel early and check the test certificates."
      }
    ]
  },
  {
    phase: "Fabricate",
    stepRange: "STEPS 4–7",
    steps: [
      {
        num: "04",
        title: "Cutting and fit-up",
        desc: "We cut, drill and assemble members to the drawings."
      },
      {
        num: "05",
        title: "Welding and bolting",
        desc: "We weld and bolt joints to the specification."
      },
      {
        num: "06",
        title: "Surface preparation and coating",
        desc: "We clean and protect every member before it leaves the workshop."
      },
      {
        num: "07",
        title: "Inspection and quality checks",
        desc: "We check dimensions, welds and coatings."
      }
    ]
  },
  {
    phase: "Erect",
    stepRange: "STEPS 8–9",
    steps: [
      {
        num: "08",
        title: "Transport and erection",
        desc: "We deliver, lift and fix the structure in a planned sequence."
      },
      {
        num: "09",
        title: "Final checks and handover",
        desc: "We walk the site with you, resolve open items, and hand over the documents."
      }
    ]
  }
];

// Indian Standards (06 / STANDARDS)
const indianStandards = [
  {
    code: "IS 800",
    desc: "The code of practice for general construction in steel."
  },
  {
    code: "IS 2062",
    desc: "The specification for steel used in general structural work."
  },
  {
    code: "IS 816",
    desc: "The code for metal arc welding."
  },
  {
    code: "IS 4000",
    desc: "The code for high-strength bolts in steel structures."
  },
  {
    code: "IS 7215",
    desc: "The tolerances for fabricating steel structures, meaning how closely parts must match the drawings."
  },
  {
    code: "IS 12843",
    desc: "The tolerances for erecting steel structures."
  },
  {
    code: "IS 7205",
    desc: "The safety code for erecting structural steelwork."
  }
];

// Coastal Protection Points (07 / COASTAL PROTECTION)
const coastalProtectionPoints = [
  {
    num: "01",
    title: "Surface preparation first",
    desc: "Coatings only last on properly cleaned steel."
  },
  {
    num: "02",
    title: "Hot-dip galvanising for exposed members",
    desc: "It is the most common corrosion protection for outdoor steel in India."
  },
  {
    num: "03",
    title: "Paint over galvanising where needed",
    desc: "A paint topcoat over galvanising adds protection."
  },
  {
    num: "04",
    title: "Matching protection on fasteners",
    desc: "Bolts, nuts and washers need the same level of protection as the structure."
  },
  {
    num: "05",
    title: "Life cycle costing",
    desc: "We compare coating options by their full cost over time, not just the price today."
  }
];

// Schedule Protection Points (08 / SCHEDULE)
const schedulePoints = [
  {
    num: "01",
    text: "Fabrication and site work run side by side."
  },
  {
    num: "02",
    text: "We finalise fabrication drawings early, so approvals don’t hold up the workshop."
  },
  {
    num: "03",
    text: "We order materials early."
  },
  {
    num: "04",
    text: "We plan the erection sequence with your project team before steel leaves the workshop."
  }
];

// Quality Checkpoints Timeline (09 / QUALITY)
const qualityCheckpoints = [
  {
    stage: "BEFORE CUTTING",
    text: "We check material test certificates."
  },
  {
    stage: "DURING FABRICATION",
    text: "We check dimensions against the drawings."
  },
  {
    stage: "AT JOINTS",
    text: "We inspect welds and bolt tightening."
  },
  {
    stage: "BEFORE DISPATCH",
    text: "We check coatings."
  },
  {
    stage: "AT HANDOVER",
    text: "We walk through the work with you and clear every open item."
  }
];

// FAQs (10 / FAQS)
const faqsList = [
  {
    num: "01",
    q: "Is steel cheaper than RCC?",
    a: "It depends on your project. Steel often wins on speed, span and foundation weight. RCC can cost less for shorter spans and low-rise buildings. We compare both for your project."
  },
  {
    num: "02",
    q: "How long does fabrication take?",
    a: "It depends on tonnage, complexity and material availability. After we review your drawings, we give you a schedule."
  },
  {
    num: "03",
    q: "Do you handle the design too?",
    a: "Yes. Through our design-build service, we can take design, fabrication and erection under one contract."
  },
  {
    num: "04",
    q: "Will steel rust in Mangalore’s climate?",
    a: "Not when it is protected correctly. Coastal air is harsh, so we specify surface preparation and a coating system, such as galvanising plus paint, to suit your exposure."
  },
  {
    num: "05",
    q: "Does a steel building need fire protection?",
    a: "Usually, yes. RCC has better built-in fire resistance, so steel buildings typically need added fire protection to meet code requirements."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Top Utility Bar -->
  <div class="top-utility-bar">
    <div class="container utility-inner">
      <div class="utility-left">
        <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="utility-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>{siteData.contact.phone}</span>
        </a>
        <span class="utility-divider">·</span>
        <a href={`mailto:${siteData.contact.email}`} class="utility-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span>{siteData.contact.email}</span>
        </a>
      </div>
      <div class="utility-right">
        <span>Mangalore · Udupi · Coastal Karnataka</span>
      </div>
    </div>
  </div>

  <!-- Hero Section (Dark Charcoal #14171A) -->
  <section class="steel-hero section-charcoal hero" id="top">
    <!-- Background Blueprint Structural Frame Lines -->
    <div class="hero-blueprint-bg" aria-hidden="true">
      <svg class="blueprint-svg" viewBox="0 0 800 500" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M 50 480 L 50 160 L 400 40 L 750 160 L 750 480" stroke="#f0a500" stroke-width="2" stroke-opacity="0.2" />
        <path d="M 50 160 L 750 160" stroke="#f0a500" stroke-width="1.5" stroke-opacity="0.15" />
        <path d="M 400 40 L 400 160" stroke="#f0a500" stroke-width="1.5" stroke-opacity="0.15" />
        <path d="M 50 480 L 750 480" stroke="#f0a500" stroke-width="2" stroke-opacity="0.25" />
        <!-- Diagonal Web Trusses -->
        <path d="M 50 160 L 166 40 L 283 160 L 400 40 L 516 160 L 633 40 L 750 160" stroke="#f0a500" stroke-width="1" stroke-dasharray="4 4" stroke-opacity="0.18" />
        <line x1="200" y1="160" x2="200" y2="480" stroke="#f0a500" stroke-width="1" stroke-opacity="0.1" />
        <line x1="600" y1="160" x2="600" y2="480" stroke="#f0a500" stroke-width="1" stroke-opacity="0.1" />
        <!-- Base details -->
        <rect x="40" y="475" width="20" height="10" stroke="#f0a500" stroke-width="1.5" stroke-opacity="0.3" fill="none" />
        <rect x="740" y="475" width="20" height="10" stroke="#f0a500" stroke-width="1.5" stroke-opacity="0.3" fill="none" />
      </svg>
    </div>

    <div class="container hero-container">
      <div class="hero-grid">
        
        <!-- Left: Headline, Subtext, CTAs, Stats -->
        <div class="hero-left">
          <div class="section-tag reveal">
            <span class="tag-diamond">◆</span>
            <span class="tag-text">SERVICES / STEEL STRUCTURAL FABRICATION</span>
          </div>

          <h1 class="hero-headline reveal">
            Steel Structural Fabrication Contractors in <span class="highlight-orange">Mangalore &amp; Udupi</span>
          </h1>

          <p class="hero-subtext reveal">
            We fabricate and erect steel structures for industrial, commercial and institutional buildings across coastal Karnataka. We build with quality, deliver with speed, and back every project with experience.
          </p>

          <div class="hero-ctas reveal">
            <a href="#hero-enquiry-form" class="cta-orange-btn scroll-to-form">
              ENQUIRE ABOUT STEEL FABRICATION
            </a>
            <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="cta-outline-btn">
              CALL {siteData.contact.phone}
            </a>
          </div>

          <!-- Hero Proof Stats -->
          <div class="hero-proof-stats reveal">
            <div class="proof-stat-item">
              <span class="proof-title">Industrial · Commercial · Institutional</span>
              <span class="proof-label">Buildings we serve</span>
            </div>
            <div class="proof-stat-item">
              <span class="proof-title">Fabrication to erection</span>
              <span class="proof-label">One team</span>
            </div>
            <div class="proof-stat-item">
              <span class="proof-title">Quality · Speed · Experience</span>
              <span class="proof-label">What we stand for</span>
            </div>
          </div>
        </div>

        <!-- Right: Above-the-fold Enquiry Form Card -->
        <div class="hero-right reveal">
          <div class="enquiry-card" id="hero-enquiry-form">
            <div class="enquiry-card-header">
              <h3 class="enquiry-card-title">Enquire About Steel Fabrication</h3>
              <p class="enquiry-card-subtitle">Tell us what you plan to build and our engineers will get back to you.</p>
            </div>

            <form class="enquiry-form site-form" data-form-id="hero-enquiry" action="https://formsubmit.co/enquires.wrnxt@gmail.com" method="POST">
              <input type="hidden" name="_subject" value="New Steel Structural Fabrication Enquiry (Hero Form)" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="form_location" value="Hero Enquiry Form - Steel Structural Fabrication" />

              <div class="form-row-split">
                <div class="form-field">
                  <label for="hero-name">FULL NAME</label>
                  <input type="text" id="hero-name" name="name" required placeholder="Your full name" />
                </div>
                <div class="form-field">
                  <label for="hero-phone">PHONE NUMBER</label>
                  <input type="tel" id="hero-phone" name="phone" required placeholder="+91 98765 43210" />
                </div>
              </div>

              <div class="form-field">
                <label for="hero-email">EMAIL</label>
                <input type="email" id="hero-email" name="email" required placeholder="your.name@company.com" />
              </div>

              <div class="form-field">
                <label for="hero-project-type">PROJECT TYPE</label>
                <div class="select-wrapper">
                  <select id="hero-project-type" name="project_type" required>
                    <option value="" disabled selected>Select project type</option>
                    <option value="Industrial sheds & factory frames">Industrial sheds &amp; factory frames</option>
                    <option value="Warehouses & storage buildings">Warehouses &amp; storage buildings</option>
                    <option value="Roof trusses & long-span roofs">Roof trusses &amp; long-span roofs</option>
                    <option value="Commercial building frames">Commercial building frames</option>
                    <option value="Mezzanine floors, platforms & staircases">Mezzanine floors, platforms &amp; staircases</option>
                    <option value="Extensions & strengthening">Extensions &amp; strengthening</option>
                    <option value="Other steel structure">Other steel structure</option>
                  </select>
                </div>
              </div>

              <div class="form-field">
                <label for="hero-requirements">TELL US ABOUT YOUR DRAWINGS OR REQUIREMENTS</label>
                <textarea id="hero-requirements" name="requirements" rows="3" placeholder="Describe your requirements, dimensions, tonnage or timeline..."></textarea>
              </div>

              <button type="submit" class="submit-orange-btn">
                SEND ENQUIRY
              </button>

              <div class="form-response" aria-live="polite"></div>

              <p class="enquiry-card-footer">
                Prefer to talk? Call <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="phone-link">{siteData.contact.phone}</a>
              </p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 01 / OVERVIEW (Light Section - Paper #F6F3ED) -->
  <section class="section-paper section-overview" id="overview">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">01 / OVERVIEW</span>
      </div>

      <div class="overview-grid">
        <div class="overview-left reveal">
          <h2 class="overview-headline">
            Steel lets you build faster, span wider and expand later. <span class="highlight-orange">It also needs careful fabrication and the right protection from coastal air.</span>
          </h2>
        </div>
        <div class="overview-right reveal">
          <p class="overview-body">
            We handle <strong>the whole job</strong>: planning, fabrication drawings, workshop fabrication, coating, transport and erection. You deal with <strong>one team</strong> from the first drawing to the final handover.
          </p>
        </div>
      </div>

      <!-- Six-Stage Job Strip -->
      <div class="job-stages-strip reveal">
        {jobStages.map((stage) => (
          <div class={`job-stage-card ${stage.isHighlight ? 'job-stage-highlight' : ''}`}>
            <span class="job-stage-num">{stage.num}</span>
            <span class="job-stage-name">{stage.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 / SCOPE: What We Fabricate (Light Section - Paper #F6F3ED) -->
  <section class="section-paper section-scope" id="scope">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">02 / SCOPE</span>
      </div>

      <h2 class="section-heading-dark reveal">What We Fabricate</h2>

      <div class="scope-grid">
        {whatWeFabricate.map((item) => (
          <div class="scope-card reveal">
            <span class="scope-num">{item.num}</span>
            <h3 class="scope-title">{item.title}</h3>
            <p class="scope-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 / WHO THIS IS FOR (Dark Section - Charcoal #14171A) -->
  <section class="section-charcoal section-audience" id="who-this-is-for">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">03 / WHO THIS IS FOR</span>
      </div>

      <h2 class="section-heading-white reveal">Who This Is For</h2>

      <div class="audience-grid">
        {whoThisIsFor.map((item) => (
          <div class="audience-col reveal">
            <span class="audience-num">{item.num}</span>
            <h3 class="audience-title">{item.title}</h3>
            <p class="audience-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 / WHY STEEL & Honest Advice (Light Section - Paper #F6F3ED) -->
  <section class="section-paper section-why-steel" id="why-steel">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">04 / WHY STEEL</span>
      </div>

      <h2 class="section-heading-dark reveal">Why Build in Steel</h2>

      <div class="why-steel-grid">
        
        <!-- Left: 5 Numbered Benefits -->
        <div class="why-steel-left">
          <div class="benefits-row-list">
            {whySteelReasons.map((reason) => (
              <div class="benefit-row-item reveal">
                <span class="benefit-row-num">{reason.num}</span>
                <div class="benefit-row-content">
                  <h3 class="benefit-row-title">{reason.title}</h3>
                  <p class="benefit-row-desc">{reason.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Honest Advice Card -->
        <div class="why-steel-right reveal">
          <div class="honest-advice-card">
            <span class="honest-advice-tag">HONEST ADVICE</span>
            <h3 class="honest-advice-heading">Steel isn’t always the answer.</h3>
            <p class="honest-advice-body">
              RCC has better built-in fire resistance and generally needs less corrosion upkeep, and it stays cost-competitive for shorter spans and low-rise buildings. We compare both on span, budget, timeline and fire requirements, then tell you which one suits your project.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Mid-Page Orange CTA Strip (Touchpoint 3) -->
  <section class="orange-cta-strip">
    <div class="container cta-strip-inner">
      <div class="cta-strip-left">
        <h3 class="cta-strip-heading">Planning a steel structure?</h3>
        <p class="cta-strip-sub">Send us your drawings or requirements and we’ll review them.</p>
      </div>
      <div class="cta-strip-right">
        <a href="#hero-enquiry-form" class="cta-dark-btn scroll-to-form">
          ENQUIRE ABOUT STEEL FABRICATION
        </a>
      </div>
    </div>
  </section>

  <!-- 05 / PROCESS: Our Steel Fabrication Process (Dark Section - Charcoal #14171A) -->
  <section class="section-charcoal section-process" id="process">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">05 / PROCESS</span>
      </div>

      <h2 class="section-heading-white reveal">Our Steel Fabrication Process</h2>

      <div class="process-phases-grid">
        {processColumns.map((phase) => (
          <div class="process-phase-col reveal">
            <div class="phase-header-bar">
              <h3 class="phase-name">{phase.phase}</h3>
              <span class="phase-step-range">{phase.stepRange}</span>
            </div>
            <div class="phase-steps-list">
              {phase.steps.map((st) => (
                <div class="phase-step-item">
                  <span class="phase-step-num">{st.num}</span>
                  <div class="phase-step-body">
                    <h4 class="phase-step-title">{st.title}</h4>
                    <p class="phase-step-desc">{st.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 / STANDARDS: Built to Indian Standards (Light Section - Paper #F6F3ED) -->
  <section class="section-paper section-standards" id="standards">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">06 / STANDARDS</span>
      </div>

      <div class="standards-grid">
        <div class="standards-left reveal">
          <h2 class="standards-heading">Built to Indian Standards</h2>
          <p class="standards-sub">
            We follow the relevant Indian Standards for steel construction, including:
          </p>
        </div>

        <div class="standards-right reveal">
          <div class="standards-table">
            {indianStandards.map((std) => (
              <div class="standard-row">
                <span class="standard-code">{std.code}</span>
                <p class="standard-desc">{std.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 / COASTAL PROTECTION: Built for Mangalore’s Coastal Air (Dark Section - Charcoal #14171A) -->
  <section class="section-charcoal section-coastal" id="coastal-protection">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">07 / COASTAL PROTECTION</span>
      </div>

      <h2 class="section-heading-white reveal">Built for Mangalore’s Coastal Air</h2>
      <p class="section-intro-white reveal">
        Salt and humidity attack unprotected steel, so we plan corrosion protection from the start.
      </p>

      <div class="coastal-grid">
        
        <!-- Left: 5 Numbered Protection Points -->
        <div class="coastal-left">
          <div class="coastal-points-list">
