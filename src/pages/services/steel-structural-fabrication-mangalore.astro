  .submit-orange-btn:hover {
    background-color: var(--st-orange-hover);
    box-shadow: 0 4px 14px rgba(240, 165, 0, 0.4);
  }

  .enquiry-card-footer {
    font-family: var(--st-font-body);
    font-size: 0.85rem;
    text-align: center;
    color: var(--st-form-card-sub);
    margin-top: 0.5rem;
  }

  .enquiry-card-footer .phone-link {
    color: var(--st-form-card-title);
    font-weight: 600;
    text-decoration: underline;
  }

  /* ==========================================================================
     01 / OVERVIEW SECTION
     ========================================================================== */
  .section-overview {
    border-bottom: 1px solid var(--st-paper-border);
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: flex-start;
    margin-bottom: 4rem;
  }

  .overview-headline {
    font-family: var(--st-font-heading);
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--st-paper-heading);
    letter-spacing: -0.02em;
    transition: color 0.3s ease;
  }

  .overview-body {
    font-family: var(--st-font-body);
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--st-paper-text);
    transition: color 0.3s ease;
  }

  /* Six-Stage Job Strip */
  .job-stages-strip {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    background-color: var(--st-job-card-bg);
    border: 1px solid var(--st-job-card-border);
    border-radius: 4px;
    overflow: hidden;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .job-stage-card {
    padding: 1.75rem 1.25rem;
    border-right: 1px solid var(--st-job-card-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background-color: var(--st-job-card-bg);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .job-stage-card:last-child {
    border-right: none;
  }

  .job-stage-highlight {
    background-color: var(--st-job-highlight-bg) !important;
  }

  .job-stage-num {
    font-family: var(--st-font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--st-orange);
  }

  .job-stage-name {
    font-family: var(--st-font-heading);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--st-job-card-text);
    transition: color 0.3s ease;
  }

  .job-stage-highlight .job-stage-name {
    color: #FFFFFF !important;
  }

  /* ==========================================================================
     02 / SCOPE: WHAT WE FABRICATE
     ========================================================================== */
  .scope-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .scope-card {
    background-color: var(--st-card-bg);
    border: 1px solid var(--st-card-border);
    border-top: 4px solid var(--st-card-border-top);
    padding: 2.25rem 2rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--st-card-shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.3s ease, border-color 0.3s ease;
  }

  .scope-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--st-card-shadow-hover);
  }

  .scope-num {
    font-family: var(--st-font-heading);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--st-orange);
  }

  .scope-title {
    font-family: var(--st-font-heading);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--st-paper-heading);
    line-height: 1.25;
    transition: color 0.3s ease;
  }

  .scope-desc {
    font-family: var(--st-font-body);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--st-paper-muted);
    transition: color 0.3s ease;
  }

  /* ==========================================================================
     03 / WHO THIS IS FOR
     ========================================================================== */
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
  }

  .audience-col {
    border-top: 2px solid var(--st-orange);
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .audience-num {
    font-family: var(--st-font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--st-orange);
  }

  .audience-title {
    font-family: var(--st-font-heading);
    font-size: 1.35rem;
    font-weight: 500;
    color: #FFFFFF;
    line-height: 1.2;
  }

  .audience-desc {
    font-family: var(--st-font-body);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--st-charcoal-muted);
  }

  /* ==========================================================================
     04 / WHY BUILD IN STEEL & HONEST ADVICE
     ========================================================================== */
  .why-steel-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: flex-start;
  }

  .benefits-row-list {
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--st-paper-heading);
    transition: border-color 0.3s ease;
  }

  .benefit-row-item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--st-paper-border);
    transition: border-color 0.3s ease;
  }

  .benefit-row-num {
    font-family: var(--st-font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--st-orange);
  }

  .benefit-row-title {
    font-family: var(--st-font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--st-paper-heading);
    margin-bottom: 0.35rem;
    transition: color 0.3s ease;
  }

  .benefit-row-desc {
    font-family: var(--st-font-body);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--st-paper-muted);
    transition: color 0.3s ease;
  }

  .honest-advice-card {
    background-color: var(--st-charcoal);
    color: #FFFFFF;
    border-radius: 4px;
    padding: 3rem 2.5rem;
    position: relative;
    border-left: 5px solid var(--st-orange);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .honest-advice-tag {
    display: inline-block;
    font-family: var(--st-font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--st-orange);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .honest-advice-heading {
    font-family: var(--st-font-heading);
    font-size: 2.15rem;
    font-weight: 500;
    color: #FFFFFF;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .honest-advice-body {
    font-family: var(--st-font-body);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--st-charcoal-subtext);
  }

  /* ==========================================================================
     ORANGE CTA STRIP (Touchpoint 3)
     ========================================================================== */
  .orange-cta-strip {
    background-color: var(--st-orange);
    color: #000000;
    padding: 3.5rem 0;
  }

  .cta-strip-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .cta-strip-heading {
    font-family: var(--st-font-heading);
    font-size: clamp(1.85rem, 3.5vw, 2.25rem);
    font-weight: 500;
    color: #000000;
    line-height: 1.2;
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }

  .cta-strip-sub {
    font-family: var(--st-font-body);
    font-size: 1.05rem;
    color: #1A1A1A;
  }

  .cta-dark-btn {
    background-color: #14171A;
    color: #FFFFFF;
    font-family: var(--st-font-heading);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 1.15rem 2.25rem;
    border-radius: 4px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    min-height: 48px;
  }

  .cta-dark-btn:hover {
    background-color: #000000;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
  }

  /* ==========================================================================
     05 / PROCESS: OUR STEEL FABRICATION PROCESS
     ========================================================================== */
  .process-phases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }

  .process-phase-col {
    display: flex;
    flex-direction: column;
  }

  .phase-header-bar {
    border-bottom: 2px solid var(--st-charcoal-border);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .phase-name {
    font-family: var(--st-font-heading);
    font-size: 1.75rem;
    font-weight: 500;
    color: #FFFFFF;
  }

  .phase-step-range {
    font-family: var(--st-font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--st-orange);
  }

  .phase-steps-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .phase-step-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .phase-step-num {
    font-family: var(--st-font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--st-orange);
  }

  .phase-step-title {
    font-family: var(--st-font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    color: #FFFFFF;
    line-height: 1.25;
  }

  .phase-step-desc {
    font-family: var(--st-font-body);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--st-charcoal-muted);
  }

  /* ==========================================================================
     06 / STANDARDS: BUILT TO INDIAN STANDARDS
     ========================================================================== */
  .standards-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4.5rem;
    align-items: flex-start;
  }

  .standards-heading {
    font-family: var(--st-font-heading);
    font-size: clamp(2rem, 4.2vw, 2.75rem);
    font-weight: 500;
    color: var(--st-paper-heading);
    line-height: 1.2;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    transition: color 0.3s ease;
  }

  .standards-sub {
    font-family: var(--st-font-body);
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--st-paper-muted);
    transition: color 0.3s ease;
  }

  .standards-table {
    border-top: 2px solid var(--st-paper-heading);
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease;
  }

  .standard-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 2rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--st-paper-border);
    align-items: baseline;
    transition: border-color 0.3s ease;
  }

  .standard-code {
    font-family: var(--st-font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--st-orange-dark);
  }

  .standard-desc {
    font-family: var(--st-font-body);
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--st-paper-text);
    transition: color 0.3s ease;
  }

  /* ==========================================================================
     07 / COASTAL PROTECTION
     ========================================================================== */
  .section-intro-white {
    font-family: var(--st-font-body);
    font-size: 1.15rem;
    color: var(--st-charcoal-subtext);
    max-width: 750px;
    margin-bottom: 3.5rem;
  }

  .coastal-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4.5rem;
    align-items: flex-start;
  }

  .coastal-points-list {
    border-top: 1px solid var(--st-charcoal-border);
    display: flex;
    flex-direction: column;
  }

  .coastal-point-item {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1.25rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--st-charcoal-border);
  }

  .coastal-point-num {
    font-family: var(--st-font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--st-orange);
  }

  .coastal-point-title {
    font-family: var(--st-font-heading);
    font-size: 1.2rem;
    font-weight: 500;
    color: #FFFFFF;
    margin-bottom: 0.35rem;
  }

  .coastal-point-desc {
    font-family: var(--st-font-body);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--st-charcoal-muted);
  }

  /* Protection Layer Diagram Card */
  .layer-diagram-card {
    background-color: var(--st-charcoal-card);
    border: 1px solid var(--st-charcoal-border);
    border-radius: 4px;
    padding: 2.5rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  .layer-diagram-tag {
    display: inline-block;
    font-family: var(--st-font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--st-orange);
    margin-bottom: 2rem;
    text-transform: uppercase;
  }

  .layer-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .layer-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-radius: 3px;
    font-family: var(--st-font-heading);
    font-weight: 600;
  }

  .layer-paint {
    background-color: var(--st-orange);
    color: #000000;
  }

  .layer-galvanising {
    background-color: #D1D5DB;
    color: #111827;
  }

  .layer-steel {
    background-color: #374151;
    color: #FFFFFF;
  }

  .layer-name {
    font-size: 1.05rem;
  }

  .layer-badge {
    font-family: var(--st-font-body);
    font-size: 0.78rem;
    font-weight: 600;
    opacity: 0.9;
  }

  .layer-diagram-footnote {
    font-family: var(--st-font-body);
    font-size: 0.85rem;
    color: var(--st-charcoal-muted);
    line-height: 1.5;
  }

  /* ==========================================================================
     08 / SCHEDULE & 09 / QUALITY SECTION
     ========================================================================== */
  .schedule-quality-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    margin-bottom: 5rem;
  }

  .schedule-list {
    border-top: 2px solid var(--st-paper-heading);
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease;
  }

  .schedule-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--st-paper-border);
    align-items: baseline;
    transition: border-color 0.3s ease;
  }

  .schedule-num {
    font-family: var(--st-font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--st-orange-dark);
  }

  .schedule-text {
    font-family: var(--st-font-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--st-paper-text);
    transition: color 0.3s ease;
  }

  /* Checkpoint Timeline */
  .checkpoint-timeline {
    position: relative;
    padding-left: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .checkpoint-timeline::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background-color: var(--st-orange);
  }

  .checkpoint-item {
    position: relative;
  }

  .checkpoint-marker {
    position: absolute;
    left: -2rem;
    top: 4px;
  }

  .checkpoint-dot {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--st-orange);
    border: 3px solid var(--st-paper);
    box-shadow: 0 0 0 2px var(--st-orange);
    transition: border-color 0.3s ease;
  }

  .checkpoint-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .checkpoint-stage {
    font-family: var(--st-font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--st-orange-dark);
    text-transform: uppercase;
  }

  .checkpoint-text {
    font-family: var(--st-font-body);
    font-size: 1rem;
    color: var(--st-paper-text);
    line-height: 1.45;
    transition: color 0.3s ease;
  }

  /* One Team, Design to Erection Banner */
  .one-team-banner {
    border-top: 2px solid var(--st-paper-heading);
    padding-top: 4rem;
    transition: border-color 0.3s ease;
  }

  .one-team-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4.5rem;
    align-items: flex-start;
  }

  .one-team-heading {
    font-family: var(--st-font-heading);
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 500;
    color: var(--st-paper-heading);
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .one-team-desc {
    font-family: var(--st-font-body);
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--st-paper-text);
    margin-bottom: 2rem;
    transition: color 0.3s ease;
  }

  .one-team-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .team-pill {
    background-color: var(--st-card-bg);
    border: 1px solid var(--st-card-border);
    padding: 0.6rem 1.25rem;
    border-radius: 100px;
    font-family: var(--st-font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--st-paper-heading);
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  /* ==========================================================================
     10 / FAQS SECTION
     ========================================================================== */
  .faqs-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4.5rem;
    align-items: flex-start;
  }

  .faqs-intro {
    font-family: var(--st-font-body);
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--st-charcoal-subtext);
  }

  .faqs-list {
    border-top: 1px solid var(--st-charcoal-border);
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--st-charcoal-border);
  }

  .faq-num {
    font-family: var(--st-font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--st-orange);
  }

  .faq-question {
    font-family: var(--st-font-heading);
    font-size: 1.3rem;
    font-weight: 500;
    color: #FFFFFF;
    line-height: 1.25;
    margin-bottom: 0.65rem;
  }

  .faq-answer {
    font-family: var(--st-font-body);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--st-charcoal-muted);
  }

  /* ==========================================================================
     CLOSING ORANGE SECTION WITH FORM (Touchpoint 4)
     ========================================================================== */
  .orange-closing-section {
    background-color: var(--st-orange);
    color: #000000;
    padding: 6rem 0;
  }

  .closing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4.5rem;
    align-items: flex-start;
  }

  .closing-headline {
    font-family: var(--st-font-heading);
    font-size: clamp(2.25rem, 4.2vw, 3.75rem);
    font-weight: 500;
    color: #000000;
    line-height: 1.25;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .closing-subtext {
    font-family: var(--st-font-body);
    font-size: 1.15rem;
    line-height: 1.65;
    color: #1A1A1A;
    margin-bottom: 3rem;
    max-width: 500px;
  }

  .direct-call-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .direct-call-label {
    font-family: var(--st-font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #000000;
    text-transform: uppercase;
  }

  .direct-call-phone {
    font-family: var(--st-font-heading);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 600;
    color: #000000;
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: opacity 0.2s ease;
  }

  .direct-call-phone:hover {
    opacity: 0.85;
  }

  /* Quote Card Specific Adjustments in Closing */
  .quote-card {
    border-top: 5px solid #000000;
  }

  /* Form Responses */
  .form-response {
    padding: 0;
    margin-top: 0;
    font-size: 0.9rem;
    font-family: var(--st-font-body);
    border-radius: 4px;
    display: none;
  }

  .form-response.success {
    display: block;
    padding: 0.85rem;
    margin-top: 0.5rem;
