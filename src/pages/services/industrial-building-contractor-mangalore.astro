---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteData } from '../../data/site';

const pageTitle = "Industrial Building Contractor Mangalore";
const pageDescription = "Industrial building construction services in Mangalore, Udupi & Dakshina Kannada. Sand pad foundations, heavy-duty VDF flooring, clear-span industrial steel sheds, and single-source execution built for long-term structural durability.";

// 02 / CREDENTIALS
const credentialsList = [
  {
    num: "01",
    title: "ISO-Certified",
    desc: "Strict QA/QC protocols implemented across every phase of structural execution."
  },
  {
    num: "02",
    title: "Environmental Compliance",
    desc: "Full adherence to state industrial board regulations, fire safety standards, and local municipal zoning requirements."
  },
  {
    num: "03",
    title: "Comprehensive Project Insurance",
    desc: "Full coverage including workers’ compensation, builder’s risk, and third-party property liability."
  }
];

// 03 / CORE CAPABILITIES
const capabilitiesList = [
  {
    num: "01",
    title: "Cargo Handling Industrial Sheds & Warehouses",
    desc: "We design and erect high-clearance, clear-span industrial sheds engineered specifically for logistics hubs, manufacturing units, and cargo terminals.",
    bullets: [
      "Heavy-load structural steel frameworks designed to withstand high coastal wind loads.",
      "Wide clear-span designs optimizing interior storage capacity and forklift maneuvering.",
      "Integrated ventilation, high-bay lighting layouts, and weather-proof roofing systems."
    ]
  },
  {
    num: "02",
    title: "Heavy-Duty Vacuum Dewatered Flooring (VDF / Tremix)",
    desc: "Floor failure is the leading cause of industrial downtime. We specialize in precision-engineered VDF flooring designed to handle intense machinery vibrations and constant vehicular traffic.",
    bullets: [
      "High Impact & Abrasion Resistance: Compressive strength engineered for heavy forklift movement and multi-tier pallet stacking.",
      "Reduced Shrinkage / Cracking: Vacuum dewatering extracts excess mixing water from the concrete matrix, delivering a dense, dust-free surface.",
      "Custom Hardener Finishes: Wear-resistant liquid surface hardeners applied for superior chemical, oil, and heavy wear resistance."
    ]
  },
  {
    num: "03",
    title: "Sand Pad Foundations",
    desc: "Proper load distribution is critical when building on coastal soils. We bring proven expertise in constructing high-capacity Sand Pad Foundations.",
    bullets: [
      "Heavy Storage Tanks: Engineered sand pads designed to prevent differential settlement under massive liquid or bulk solid loads.",
      "Granaries & Grain Storage: Heavy-capacity foundations built to support truck tanker filling bays and industrial granaries.",
      "Machinery Raft Foundations: Vibration-isolated foundation pads engineered for heavy industrial machinery."
    ]
  },
  {
    num: "04",
    title: "Processing Plants & Factory Infrastructure",
    desc: "Complete civil and structural infrastructure development for manufacturing plants, assembly units, and heavy industrial operations.",
    bullets: []
  }
];

// 04 / COASTAL EXPERTISE
const coastalExpertiseList = [
  {
    num: "01",
    title: "Mitigating Salt Attack & Corrosion",
    desc: "Aggressive marine air accelerates rust in standard steel reinforcements. We utilize specialized anti-corrosion treatments, high-grade mix designs, and protective coatings to ensure 50+ year asset durability."
  },
  {
    num: "02",
    title: "Managing High-Energy Weather Zones",
    desc: "The coastal environment does not tolerate weak structural spots. A poorly designed drainage system, inadequate retaining wall, or unverified foundation can lead to soil erosion, structural shifting, and costly compliance delays."
  }
];

// 05 / PROCESS: 5-STAGE INDUSTRIAL CONSTRUCTION JOURNEY
const industrialJourneyStages = [
  {
    num: "1",
    title: "Technical Consultation & Site Assessment",
    desc: "We evaluate your machinery load requirements, material handling workflows, soil bearing capacity, and specific environmental factors."
  },
  {
    num: "2",
    title: "Engineering Design & Value Engineering",
    desc: "Our structural engineers design custom steel frameworks, specialized foundations (like sand pads or pile caps), and optimized layout plans while maintaining strict budgetary control."
  },
  {
    num: "3",
    title: "Statutory Approvals & Clearances",
    desc: "We manage all necessary industrial building permits, environmental clearances, and local body sanctions so your project starts smoothly and legally."
  },
  {
    num: "4",
    title: "Precision Industrial Execution",
    desc: "Our specialized site teams execute heavy structural steel fabrication, mass concrete pours, VDF flooring installation, and MEP utility integration under strict safety supervision."
  },
  {
    num: "5",
    title: "Commissioning & Project Handover",
    desc: "We conduct rigorous load testing, system check-outs, final safety audits, and deliver complete as-built documentation and warranty logs."
  }
];

// 06 / BEYOND THE BUILD: OTHER ESSENTIAL ELEMENTS
const essentialElementsList = [
  {
    num: "01",
    title: "Zero-Downtime Expansion Planning",
    desc: "Phased construction methodologies designed for active factory upgrades or plant expansions without halting daily operations."
  },
  {
    num: "02",
    title: "Transparent Project Tracking",
    desc: "Line-item cost reporting, milestone updates, and rigorous change-order management."
  },
  {
    num: "03",
    title: "HSE-Compliant Job Sites",
    desc: "Zero-compromise worker safety, health, and environmental standards enforced on every site."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Top Utility Bar -->
  <div class="top-utility-bar">
    <div class="container utility-inner">
      <div class="utility-left">
        <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="utility-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>{siteData.contact.phone}</span>
        </a>
        <span class="utility-divider">·</span>
        <a href={`mailto:${siteData.contact.email}`} class="utility-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span>{siteData.contact.email}</span>
        </a>
      </div>
      <div class="utility-right">
        <span>Mangalore · Udupi · Dakshina Kannada</span>
      </div>
    </div>
  </div>

  <!-- Hero Section (Dark Charcoal #14171A) -->
  <section class="ind-hero section-charcoal hero" id="top">
    <!-- Background Blueprint Technical Illustration (Shed, Tank & Sand Pad) -->
    <div class="hero-blueprint-bg" aria-hidden="true">
      <svg class="blueprint-svg" viewBox="0 0 800 550" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Industrial Shed Portal Frame -->
        <path d="M 40 480 L 40 200 L 320 80 L 600 200 L 600 480" stroke="#f0a500" stroke-width="2" stroke-opacity="0.22" />
        <line x1="40" y1="200" x2="600" y2="200" stroke="#f0a500" stroke-width="1.5" stroke-opacity="0.15" />
        <line x1="320" y1="80" x2="320" y2="200" stroke="#f0a500" stroke-width="1.5" stroke-opacity="0.15" />
        <!-- Storage Tank Profile on the right -->
        <rect x="640" y="220" width="130" height="260" rx="4" stroke="#f0a500" stroke-width="1.5" stroke-opacity="0.2" />
        <ellipse cx="705" cy="220" rx="65" ry="18" stroke="#f0a500" stroke-width="1.5" stroke-opacity="0.2" />
        <line x1="770" y1="240" x2="770" y2="480" stroke="#f0a500" stroke-width="1" stroke-opacity="0.12" />
        <!-- Sand Pad Foundation Base -->
        <line x1="20" y1="480" x2="790" y2="480" stroke="#f0a500" stroke-width="2" stroke-opacity="0.28" />
        <rect x="620" y="480" width="170" height="35" stroke="#f0a500" stroke-width="1.5" stroke-dasharray="4 4" stroke-opacity="0.3" fill="none" />
        <!-- Crane beam line inside shed -->
        <line x1="40" y1="280" x2="600" y2="280" stroke="#f0a500" stroke-width="1.5" stroke-dasharray="6 4" stroke-opacity="0.18" />
      </svg>
    </div>

    <div class="container hero-container">
      <div class="hero-grid">
        
        <!-- Left Column: Copy & Actions -->
        <div class="hero-left">
          <div class="section-tag reveal">
            <span class="tag-diamond">◆</span>
            <span class="tag-text">SERVICES / INDUSTRIAL BUILDING CONTRACTOR</span>
          </div>

          <h1 class="hero-headline reveal">
            Industrial Building Construction Services in <span class="highlight-orange">Mangalore, Udupi &amp; Dakshina Kannada</span>
          </h1>

          <p class="hero-subtext reveal">
            Industrial facilities with high-volume cargo movement, heavy machinery vibration and coastal soil conditions require a well-planned industrial building structure that can last long-term. We provide industrial construction services across Mangalore &amp; Udupi.
          </p>

          <div class="hero-ctas reveal">
            <a href="#hero-enquiry-form" class="cta-orange-btn scroll-to-form">
              SCHEDULE AN INDUSTRIAL CONSULTATION
            </a>
            <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="cta-outline-btn">
              CALL {siteData.contact.phone}
            </a>
          </div>

          <!-- Hero Proof Stats -->
          <div class="hero-proof-stats reveal">
            <div class="proof-stat-item">
              <span class="proof-title">21 years</span>
              <span class="proof-label">In the business</span>
            </div>
            <div class="proof-stat-item">
              <span class="proof-title">Sand Pad Foundations · VDF Flooring · Steel Sheds</span>
              <span class="proof-label">What we build</span>
            </div>
            <div class="proof-stat-item">
              <span class="proof-title">Single-source execution</span>
              <span class="proof-label">One accountable team</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Above-the-fold Enquiry Form Card -->
        <div class="hero-right reveal">
          <div class="enquiry-card" id="hero-enquiry-form">
            <div class="enquiry-card-header">
              <h3 class="enquiry-card-title">Enquire About Industrial Construction</h3>
              <p class="enquiry-card-subtitle">Tell us about your facility and our engineers will get back to you.</p>
            </div>

            <form class="enquiry-form site-form" data-form-id="hero-enquiry" action="https://formsubmit.co/enquires.wrnxt@gmail.com" method="POST">
              <input type="hidden" name="_subject" value="New Industrial Building Construction Enquiry (Hero Form)" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="form_location" value="Hero Enquiry Form - Industrial Building Construction" />

              <div class="form-row-split">
                <div class="form-field">
                  <label for="hero-name">FULL NAME</label>
                  <input type="text" id="hero-name" name="name" required placeholder="Your full name" />
                </div>
                <div class="form-field">
                  <label for="hero-phone">PHONE NUMBER</label>
                  <input type="tel" id="hero-phone" name="phone" required placeholder="+91 98765 43210" />
                </div>
              </div>

              <div class="form-field">
                <label for="hero-email">EMAIL</label>
                <input type="email" id="hero-email" name="email" required placeholder="your.name@company.com" />
              </div>

              <div class="form-field">
                <label for="hero-facility-type">FACILITY TYPE</label>
                <div class="select-wrapper">
                  <select id="hero-facility-type" name="facility_type" required>
                    <option value="" disabled selected>Select facility type</option>
                    <option value="Cargo Handling Industrial Sheds & Warehouses">Cargo Handling Industrial Sheds &amp; Warehouses</option>
                    <option value="Heavy-Duty VDF / Tremix Flooring">Heavy-Duty VDF / Tremix Flooring</option>
                    <option value="Sand Pad Foundations / Heavy Storage Tanks">Sand Pad Foundations / Heavy Storage Tanks</option>
                    <option value="Processing Plants & Factory Infrastructure">Processing Plants &amp; Factory Infrastructure</option>
                    <option value="Granaries & Grain Storage Facility">Granaries &amp; Grain Storage Facility</option>
                    <option value="Machinery Raft Foundations">Machinery Raft Foundations</option>
                    <option value="Factory Expansion / Upgrades">Factory Expansion / Upgrades</option>
                    <option value="Other Industrial Facility">Other Industrial Facility</option>
                  </select>
                </div>
              </div>

              <div class="form-field">
                <label for="hero-requirements">TELL US ABOUT YOUR SITE AND LOAD REQUIREMENTS</label>
                <textarea id="hero-requirements" name="requirements" rows="3" placeholder="Describe your site location, machinery loads, workflows or drawings..."></textarea>
              </div>

              <button type="submit" class="submit-orange-btn">
                SEND ENQUIRY
              </button>

              <div class="form-response" aria-live="polite"></div>

              <p class="enquiry-card-footer">
                Prefer to talk? Call <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="phone-link">{siteData.contact.phone}</a>
              </p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 01 / OVERVIEW & 02 / CREDENTIALS (Light Section - Paper #F6F3ED) -->
  <section class="section-paper section-overview-credentials" id="overview">
    <div class="container">
      
      <!-- 01 / OVERVIEW -->
      <div class="overview-block">
        <div class="section-tag reveal">
          <span class="tag-diamond">◆</span>
          <span class="tag-text">01 / OVERVIEW</span>
        </div>

        <h2 class="overview-big-headline reveal">
          From high-capacity Sand Pad Foundations to heavy-duty Vacuum Dewatered Flooring (VDF) for cargo handling sheds, <span class="highlight-orange">we deliver single-source execution built for long-term structural durability.</span>
        </h2>

        <div class="overview-split-grid">
          <div class="overview-left-stat reveal">
            <span class="years-big-num">21</span>
            <span class="years-label">Years of Experience</span>
          </div>

          <div class="overview-right-text reveal">
            <p class="overview-lead-body">
              With <strong>21 years in the business</strong>, Sri Lakshmi Construction brings <strong>two decades of industrial civil engineering experience</strong> to the Mangalore &amp; Udupi region. We understand the <strong>rigorous safety, load-bearing, and environmental challenges</strong> associated with large-scale industrial assets.
            </p>
          </div>
        </div>
      </div>

      <div class="section-divider-line"></div>

      <!-- 02 / CREDENTIALS -->
      <div class="credentials-block" id="credentials">
        <div class="section-tag reveal">
          <span class="tag-diamond">◆</span>
          <span class="tag-text">02 / CREDENTIALS</span>
        </div>

        <h2 class="section-heading-dark reveal">Certified Contractor</h2>

        <div class="credentials-3col-grid">
          {credentialsList.map((item) => (
            <div class="credential-card reveal">
              <span class="credential-num">{item.num}</span>
              <h3 class="credential-title">{item.title}</h3>
              <p class="credential-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- 03 / CAPABILITIES (Dark Section - Charcoal #14171A) -->
  <section class="section-charcoal section-capabilities" id="capabilities">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">03 / CAPABILITIES</span>
      </div>

      <h2 class="section-heading-white reveal">
        Our Core Industrial Construction Capabilities
      </h2>

      <div class="capabilities-grid">
        {capabilitiesList.map((item) => (
          <div class="capability-card reveal">
            <span class="capability-num">{item.num}</span>
            <h3 class="capability-title">{item.title}</h3>
            <p class="capability-desc">{item.desc}</p>

            {item.bullets.length > 0 && (
              <ul class="capability-bullets">
                {item.bullets.map((b) => (
                  <li class="capability-bullet-item">
                    <span class="bullet-square">■</span>
                    <span class="bullet-text">{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>

      <!-- Related Service Navigation Box -->
      <div class="related-service-box reveal">
        <a href="/services/steel-structural-fabrication-mangalore/" class="related-service-link">
          <div class="related-service-content">
            <span class="related-tag">RELATED SERVICE</span>
            <h4 class="related-title">Steel structural fabrication</h4>
          </div>
          <span class="related-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Mid-Page Orange CTA Strip (Touchpoint 3) -->
  <section class="orange-cta-strip">
    <div class="container cta-strip-inner">
      <div class="cta-strip-left">
        <h3 class="cta-strip-heading">Have an industrial project in mind?</h3>
        <p class="cta-strip-sub">Tell us about your machinery loads and site, and our engineers will take it from there.</p>
      </div>
      <div class="cta-strip-right">
        <a href="#hero-enquiry-form" class="cta-dark-btn scroll-to-form">
          SCHEDULE AN INDUSTRIAL CONSULTATION
        </a>
      </div>
    </div>
  </section>

  <!-- 04 / COASTAL EXPERTISE (Light Section - Paper #F6F3ED) -->
  <section class="section-paper section-coastal-expertise" id="coastal-expertise">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">04 / COASTAL EXPERTISE</span>
      </div>

      <h2 class="section-heading-dark reveal">
        Why Coastal Industrial Construction Requires Local Expertise
      </h2>
      <p class="section-sub-dark reveal">
        Industrial construction in this region requires specialized coastal engineering strategies:
      </p>

      <div class="coastal-expertise-grid">
        {coastalExpertiseList.map((item) => (
          <div class="coastal-card reveal">
            <span class="coastal-num">{item.num}</span>
            <h3 class="coastal-title">{item.title}</h3>
            <p class="coastal-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 / PROCESS: Our 5-Stage Industrial Construction Journey (Dark Section - Charcoal #14171A) -->
  <section class="section-charcoal section-process" id="process">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">05 / PROCESS</span>
      </div>

      <h2 class="section-heading-white reveal">
        Our 5-Stage Industrial Construction Journey
      </h2>

      <!-- Progress Timeline Track -->
      <div class="journey-track reveal" aria-hidden="true">
        <div class="journey-line"></div>
        <div class="journey-nodes">
          {industrialJourneyStages.map((stage, idx) => (
            <div class={`journey-node ${idx === 0 ? 'node-highlight' : ''}`}>
              <span class="node-circle">{stage.num}</span>
              <span class="node-title">{stage.title}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 5 Step Cards Grid -->
      <div class="process-stages-grid">
        {industrialJourneyStages.map((stage) => (
          <div class="process-stage-card reveal">
            <div class="stage-num-badge">{stage.num}</div>
            <h3 class="stage-title">{stage.title}</h3>
            <p class="stage-desc">{stage.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 / BEYOND THE BUILD: Other Essential Elements (Light Section - Paper #F6F3ED) -->
  <section class="section-paper section-essential-elements" id="beyond-the-build">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">06 / BEYOND THE BUILD</span>
      </div>

      <h2 class="section-heading-dark reveal">
        Other Essential Elements for Industrial Clients
      </h2>

      <div class="essential-elements-grid">
        {essentialElementsList.map((item) => (
          <div class="essential-card reveal">
            <span class="essential-num">{item.num}</span>
            <h3 class="essential-title">{item.title}</h3>
            <p class="essential-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing Statement Section (Dark Section - Charcoal #14171A) -->
  <section class="section-charcoal section-closing-statement" id="foundation-of-strength">
    <div class="container">
      <div class="closing-statement-grid">
        <div class="closing-statement-left reveal">
          <h2 class="closing-statement-heading">
            Build Your Industrial Asset on a <span class="highlight-orange">Foundation of Strength</span>
          </h2>
        </div>
        <div class="closing-statement-right reveal">
          <p class="closing-statement-body">
            Industrial developments are long-term capital investments that require <strong>absolute engineering precision, financial predictability, and uncompromising safety</strong>. Backed by 21 years in the business, Sri Lakshmi Construction delivers robust industrial infrastructure built for peak operational performance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing Orange CTA Strip with Form (Touchpoint 4) -->
  <section class="orange-closing-section" id="consultation-section">
    <div class="container">
      <div class="closing-grid">
        
        <!-- Left Column: Big Headline & Direct Call -->
        <div class="closing-left reveal">
          <h2 class="closing-headline">
            Ready to discuss your industrial facility, warehouse, or factory expansion?
          </h2>

          <div class="direct-call-box">
            <span class="direct-call-label">CALL OUR ENGINEERS DIRECTLY</span>
            <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="direct-call-phone">
              {siteData.contact.phone}
            </a>
          </div>
        </div>

        <!-- Right Column: Form Card -->
        <div class="closing-right reveal">
          <div class="enquiry-card quote-card" id="closing-enquiry-form">
            <div class="enquiry-card-header">
              <h3 class="enquiry-card-title">Schedule an Industrial Consultation</h3>
              <p class="enquiry-card-subtitle">Share a few details about your facility.</p>
            </div>

            <form class="enquiry-form site-form" data-form-id="closing-enquiry" action="https://formsubmit.co/enquires.wrnxt@gmail.com" method="POST">
              <input type="hidden" name="_subject" value="New Industrial Building Consultation Request (Closing Form)" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="form_location" value="Closing Consultation Form - Industrial Building Construction" />

              <div class="form-row-split">
                <div class="form-field">
                  <label for="close-name">FULL NAME</label>
                  <input type="text" id="close-name" name="name" required placeholder="Your full name" />
                </div>
                <div class="form-field">
                  <label for="close-phone">PHONE NUMBER</label>
                  <input type="tel" id="close-phone" name="phone" required placeholder="+91 98765 43210" />
                </div>
              </div>

              <div class="form-field">
                <label for="close-email">EMAIL</label>
                <input type="email" id="close-email" name="email" required placeholder="your.name@company.com" />
              </div>

              <div class="form-field">
                <label for="close-facility-type">FACILITY TYPE</label>
                <div class="select-wrapper">
                  <select id="close-facility-type" name="facility_type" required>
                    <option value="" disabled selected>Select facility type</option>
                    <option value="Cargo Handling Industrial Sheds & Warehouses">Cargo Handling Industrial Sheds &amp; Warehouses</option>
                    <option value="Heavy-Duty VDF / Tremix Flooring">Heavy-Duty VDF / Tremix Flooring</option>
                    <option value="Sand Pad Foundations / Heavy Storage Tanks">Sand Pad Foundations / Heavy Storage Tanks</option>
                    <option value="Processing Plants & Factory Infrastructure">Processing Plants &amp; Factory Infrastructure</option>
                    <option value="Granaries & Grain Storage Facility">Granaries &amp; Grain Storage Facility</option>
                    <option value="Machinery Raft Foundations">Machinery Raft Foundations</option>
                    <option value="Factory Expansion / Upgrades">Factory Expansion / Upgrades</option>
                    <option value="Other Industrial Facility">Other Industrial Facility</option>
                  </select>
                </div>
              </div>

              <div class="form-field">
                <label for="close-requirements">TELL US ABOUT YOUR SITE AND LOAD REQUIREMENTS</label>
                <textarea id="close-requirements" name="requirements" rows="3" placeholder="Describe your site location, machinery loads, workflows or drawings..."></textarea>
              </div>

              <button type="submit" class="submit-orange-btn">
