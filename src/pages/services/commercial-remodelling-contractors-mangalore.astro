          <p class="prompt-sub">Our experts will assess your property and recommend what it needs.</p>
        </div>
        <div class="prompt-right">
          <a href="#hero-assessment-form" class="cta-amber-btn scroll-to-form">
            SCHEDULE A SITE ASSESSMENT
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 06: Quality Control & Project Closeout -->
  <section class="section-charcoal section-quality" id="quality">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">06 / QUALITY CONTROL</span>
