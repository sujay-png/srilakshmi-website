  .assessment-footer-text .phone-link {
    color: var(--rm-paper-body);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--rm-amber);
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .assessment-footer-text .phone-link:hover {
    color: var(--rm-amber);
  }

  .form-response {
    display: none;
    padding: 0.75rem 1rem;
    border-radius: 4px;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .form-response.success {
    display: block;
    background-color: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  /* TRUSTED BY STRIP */
  .trusted-section {
    background-color: var(--rm-trusted-bg);
    padding: 2.25rem 0;
    border-top: 1px solid var(--rm-paper-border);
    border-bottom: 1px solid var(--rm-paper-border);
    transition: background-color 0.35s ease, border-color 0.35s ease;
  }

  .trusted-container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 1024px) {
    .trusted-container {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }
  }

  .trusted-label {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rm-trusted-label);
    flex-shrink: 0;
    transition: color 0.35s ease;
  }

  .trusted-clients-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .trusted-client-name {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--rm-trusted-text);
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  .trusted-client-name:hover {
    color: var(--rm-amber);
  }

  /* SECTION 01: OVERVIEW */
  .section-overview {
    border-bottom: 1px solid var(--rm-paper-border);
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .overview-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 5rem;
      align-items: start;
    }
  }

  .overview-headline {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--rm-paper-text);
    transition: color 0.35s ease;
  }

  .overview-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--rm-paper-body);
    font-weight: 400;
    transition: color 0.35s ease;
  }

  /* SECTION 02: EXPERTISE */
  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 960px) {
    .expertise-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 5rem;
    }
  }

  .expertise-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 3.2vw, 2.65rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--rm-paper-text);
    margin-bottom: 1.25rem;
    transition: color 0.35s ease;
  }

  .expertise-sub {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--rm-paper-body);
    margin-bottom: 2rem;
    transition: color 0.35s ease;
  }

  .enquire-arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rm-paper-text);
    border-bottom: 2px solid var(--rm-amber);
    padding-bottom: 0.35rem;
    transition: all 0.25s ease;
  }

  .enquire-arrow-link:hover {
    color: var(--rm-amber);
    gap: 0.75rem;
  }

  .arrow-symbol {
    font-size: 1.15rem;
    transition: transform 0.25s ease;
  }

  .enquire-arrow-link:hover .arrow-symbol {
    transform: translateX(4px);
  }

  .expertise-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rm-paper-border);
    transition: border-color 0.35s ease;
  }

  .expertise-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rm-paper-border);
    align-items: start;
    transition: border-color 0.35s ease;
  }

  .expertise-num {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--rm-amber);
    line-height: 1.3;
  }

  .expertise-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--rm-paper-text);
    margin-bottom: 0.5rem;
    letter-spacing: -0.015em;
    transition: color 0.35s ease;
  }

  .expertise-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--rm-paper-body);
    transition: color 0.35s ease;
  }

  /* SLIM CTA BAR */
  .slim-cta-bar {
    background-color: var(--rm-charcoal);
    color: #ffffff;
    padding: 3rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: background-color 0.35s ease;
  }

  .slim-cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .slim-cta-title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .slim-cta-desc {
    font-size: 0.95rem;
    color: #ffffff;
    opacity: 0.85;
  }

  /* SECTION 03: PROCESS */
  .section-process {
    padding-bottom: 7rem;
  }

  .process-header {
    max-width: 900px;
    margin-bottom: 4rem;
  }

  .process-intro {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .process-intro-sub {
    font-size: 0.95rem;
    color: #ffffff;
    opacity: 0.85;
  }

  .phases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 900px) {
    .phases-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .phase-column {
    display: flex;
    flex-direction: column;
  }

  .phase-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    margin-bottom: 1.75rem;
  }

  .phase-name {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 500;
    color: #ffffff;
  }

  .phase-step-range {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    opacity: 0.8;
  }

  .phase-steps-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .phase-step-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .phase-step-num {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--rm-amber);
  }

  .phase-step-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .phase-step-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #ffffff;
    opacity: 0.9;
  }

  /* RELATED READING */
  .related-reading-box {
    background-color: var(--rm-charcoal-card);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 1.75rem 2.25rem;
    margin-top: 1rem;
    transition: background-color 0.35s ease;
  }

  .related-reading-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .related-tag {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rm-amber);
    display: block;
    margin-bottom: 0.35rem;
  }

  .related-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .related-sub {
    font-size: 0.875rem;
    color: #ffffff;
    opacity: 0.85;
  }

  .related-arrow-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: var(--rm-amber);
    color: #14171a;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .related-arrow-btn:hover {
    background-color: #ffffff;
    transform: translateX(4px);
  }

  /* AMBER BANNER */
  .amber-banner {
    background-color: var(--rm-amber);
    color: #14171a;
    padding: 3.5rem 0;
  }

  .amber-banner-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2.5rem;
  }

  .amber-banner-left {
    max-width: 650px;
  }

  .amber-banner-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 2.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #14171a;
    margin-bottom: 0.5rem;
  }

  .amber-banner-sub {
    font-size: 1rem;
    line-height: 1.5;
    color: #14171a;
  }

  .amber-banner-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .amber-banner-call {
    font-size: 0.875rem;
    font-weight: 600;
    color: #14171a;
  }

  .banner-tel-link {
    color: #14171a;
    font-weight: 700;
    text-decoration: underline;
  }

  /* SECTION 04: BENEFITS */
  .section-benefits {
    padding-bottom: 7rem;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 640px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .benefit-card {
    background-color: var(--rm-card-bg);
    border-radius: 4px;
    padding: 2.5rem 2rem;
    border: 1px solid var(--rm-card-border);
    border-top: 3px solid var(--rm-card-border-top);
    box-shadow: var(--rm-card-shadow);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.35s ease, border-color 0.35s ease;
  }

  .benefit-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--rm-card-shadow-hover);
  }

  .benefit-number {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--rm-amber);
    margin-bottom: 1rem;
    line-height: 1;
  }

  .benefit-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--rm-paper-text);
    letter-spacing: -0.015em;
    margin-bottom: 0.85rem;
    line-height: 1.25;
    transition: color 0.35s ease;
  }

  .benefit-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--rm-paper-body);
    transition: color 0.35s ease;
  }

  /* TESTIMONIALS SECTION */
  .section-testimonials {
    padding: 6rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .testimonials-header {
    margin-bottom: 3.5rem;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
  }

  .quote-mark {
    font-family: Georgia, serif;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--rm-amber);
    margin-bottom: 0.25rem;
  }

  .testimonial-quote {
    font-size: 1rem;
    line-height: 1.65;
    color: #ffffff;
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .author-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 500;
    color: #ffffff;
  }

  .author-loc {
    font-size: 0.8125rem;
    color: #ffffff;
    opacity: 0.85;
  }

  /* SECTION 05: WARNING SIGNS */
  .warning-signs-header {
    max-width: 850px;
    margin-bottom: 2.5rem;
  }

  .warning-signs-intro {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--rm-paper-body);
    transition: color 0.35s ease;
  }

  .industry-subheading {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 0.5rem;
  }

  .warning-modules-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .warning-module-card {
    background-color: transparent;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rm-paper-border);
    transition: border-color 0.35s ease;
  }

  .warning-module-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .warning-module-grid {
      grid-template-columns: 280px 1fr;
      gap: 3.5rem;
    }
  }

  .warning-module-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .module-num {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--rm-amber);
    line-height: 1;
  }

  .module-title {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 500;
    color: var(--rm-paper-text);
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: color 0.35s ease;
  }

  .warning-module-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .module-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--rm-paper-body);
    transition: color 0.35s ease;
  }

  .signs-box {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .signs-label {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rm-paper-body);
    transition: color 0.35s ease;
  }

  .signs-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 2rem;
  }

  @media (min-width: 640px) {
    .signs-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sign-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.9375rem;
    color: var(--rm-paper-body);
    line-height: 1.45;
    transition: color 0.35s ease;
  }

  .sign-bullet {
    color: var(--rm-amber);
    font-size: 0.65rem;
    margin-top: 0.25rem;
    flex-shrink: 0;
  }

  .solution-box {
    background-color: var(--rm-solution-bg);
    color: var(--rm-solution-text);
    border: 1px solid var(--rm-solution-border);
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
  }

  .solution-label {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rm-amber);
  }

  .solution-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--rm-solution-text);
  }

  /* PROMPT BOX */
  .prompt-box {
    background-color: var(--rm-card-bg);
    border: 1px solid var(--rm-card-border);
    border-radius: 4px;
    padding: 2.25rem 2.5rem;
    margin-top: 3.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    box-shadow: var(--rm-card-shadow);
    transition: background-color 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .prompt-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--rm-paper-text);
    margin-bottom: 0.35rem;
    letter-spacing: -0.015em;
    transition: color 0.35s ease;
  }

  .prompt-sub {
    font-size: 0.95rem;
    color: var(--rm-paper-body);
    transition: color 0.35s ease;
  }

  /* SECTION 06: QUALITY CONTROL */
  .quality-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .quality-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 5rem;
    }
  }

  .quality-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #ffffff;
  }

  .quality-steps-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .quality-step-item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .quality-badge {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--rm-amber);
    color: #14171a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
  }

  .quality-step-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.4rem;
  }

  .quality-step-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #ffffff;
    opacity: 0.9;
  }

  /* SECTION 07: CLOSING SECTION */
  .section-closing {
    padding: 7rem 0 8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .closing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .closing-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4.5rem;
    }
  }

  .closing-headline {
    font-family: var(--font-heading);
    font-size: clamp(2.15rem, 3.8vw, 3.25rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 1.5rem;
  }

  .closing-subtext {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #ffffff;
    margin-bottom: 2.75rem;
    max-width: 580px;
  }

  .closing-contact-details {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .closing-contact-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    align-items: baseline;
  }

  @media (max-width: 480px) {
    .closing-contact-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }

  .contact-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .contact-val-link {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .contact-val-link:hover {
    color: var(--rm-amber);
  }

  .contact-val-text {
    color: #ffffff;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Form Scroll Highlight Animation */
  .assessment-card.pulse-highlight {
    animation: pulseBorder 1.5s ease;
  }

  @keyframes pulseBorder {
    0% {
      box-shadow: 0 0 0 0 rgba(240, 165, 0, 0.7);
    }
    50% {
      box-shadow: 0 0 0 16px rgba(240, 165, 0, 0);
    }
    100% {
      box-shadow: var(--rm-card-shadow);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Smooth scroll for CTAs targeting the site assessment form
    const scrollLinks = document.querySelectorAll('.scroll-to-form');
    const heroCard = document.getElementById('hero-assessment-form');

    scrollLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetElement = heroCard || document.querySelector('.assessment-card');
        if (targetElement) {
          const headerOffset = 110;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });

          // Pulse animation on the card
          targetElement.classList.remove('pulse-highlight');
          void targetElement.offsetWidth; // trigger reflow
          targetElement.classList.add('pulse-highlight');

          // Focus first input
          const firstInput = targetElement.querySelector('input');
          if (firstInput) {
            setTimeout(() => firstInput.focus(), 500);
          }
        }
      });
    });

    // Form submission handling for both assessment forms
    const forms = document.querySelectorAll('.site-form');
    forms.forEach(form => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const responseBox = f.querySelector('.form-response') as HTMLElement;
        const submitBtn = f.querySelector('button[type="submit"]') as HTMLButtonElement;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }

        // Simulate successful request
        setTimeout(() => {
          if (responseBox) {
            responseBox.className = 'form-response success';
            responseBox.textContent = 'Thank you! Your site assessment request has been received. Our team will contact you shortly.';
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'REQUEST SENT ✓';
          }
          f.reset();
        }, 800);
      });
    });
  });
</script>
