        num: "01",
        title: "Initial Assessment and Planning",
        desc: "Evaluating the existing building, identifying renovation requirements, defining project goals, and establishing a preliminary budget."
      },
      {
        num: "02",
        title: "Design and Approvals",
        desc: "Developing the design, finalizing layouts and material selections, and obtaining the necessary permits and approvals before construction begins."
      },
      {
        num: "03",
        title: "Bidding and Contractor Selection",
        desc: "Reviewing proposals, comparing costs and timelines, evaluating contractor experience, and selecting the right team for the project."
      },
      {
        num: "04",
        title: "Contract Finalization and Scheduling",
        desc: "Defining the project scope, budget, responsibilities, timelines, and payment terms before signing the contract."
      }
    ]
  },
  {
    phase: "Build",
    stepRange: "STEPS 5–7",
    steps: [
      {
        num: "05",
        title: "Site Preparation and Material Procurement",
        desc: "Preparing the site, arranging materials and equipment, and implementing safety measures to ensure the project can proceed smoothly."
      },
      {
        num: "06",
        title: "Demolition and Removal",
        desc: "Removing outdated fixtures, finishes, partitions, or other elements as required by the renovation plan."
      },
      {
