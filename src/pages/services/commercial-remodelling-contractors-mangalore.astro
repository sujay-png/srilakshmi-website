    num: "01",
    title: "Structural Work & Layout Changes",
    desc: "Reshaping space to fit how your business actually operates today."
  },
  {
    num: "02",
    title: "Flooring & Industrial Finishes",
    desc: "Including V.D.F. (vacuum dewatered flooring) for heavy-use industrial sites."
  },
