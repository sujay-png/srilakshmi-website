          </p>
        </div>

        <div class="quality-right">
          <div class="quality-steps-list">
            {qualitySteps.map((q) => (
              <div class="quality-step-item reveal">
                <span class="quality-badge">{q.num}</span>
                <div class="quality-step-content">
                  <h3 class="quality-step-title">{q.title}</h3>
                  <p class="quality-step-desc">{q.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 07: Ready to Upgrade / Closing Assessment Form -->
  <section class="section-charcoal section-closing" id="closing-assessment">
    <div class="container">
      <div class="closing-grid">
        
        <!-- Left: Ready info -->
        <div class="closing-left reveal">
          <div class="section-tag">
            <span class="tag-diamond">◆</span>
            <span class="tag-text">READY TO BEGIN?</span>
          </div>

          <h2 class="closing-headline">
            Ready to Upgrade Your <span class="highlight-amber">Commercial Property?</span>
          </h2>

          <p class="closing-subtext">
            Sri Lakshmi Construction brings hands-on experience across apartments, educational institutions, hospitals, and industrial sites in Mangalore and coastal Karnataka.
          </p>

          <div class="closing-contact-details">
            <div class="closing-contact-row">
              <span class="contact-label">PHONE</span>
              <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="contact-val-link">
                {siteData.contact.phone}
              </a>
            </div>

            <div class="closing-contact-row">
              <span class="contact-label">EMAIL</span>
              <a href={`mailto:${siteData.contact.email}`} class="contact-val-link">
                {siteData.contact.email}
              </a>
            </div>

            <div class="closing-contact-row">
              <span class="contact-label">HEAD OFFICE</span>
              <span class="contact-val-text">
                {siteData.contact.address}
              </span>
            </div>
          </div>
        </div>

        <!-- Right: Closing Assessment Card -->
        <div class="closing-right reveal" id="closing-form-wrap">
          <div class="assessment-card" id="closing-assessment-form">
            <div class="assessment-header">
              <h3 class="assessment-title">Schedule a Site Assessment</h3>
              <p class="assessment-subtitle">Share a few details and our experts will contact you.</p>
            </div>

            <form class="assessment-form site-form" data-form-id="closing-form">
              <div class="form-row-split">
                <div class="form-field">
                  <label for="close-name">FULL NAME</label>
                  <input type="text" id="close-name" name="name" required placeholder="Your full name" />
                </div>
                <div class="form-field">
                  <label for="close-phone">PHONE NUMBER</label>
                  <input type="tel" id="close-phone" name="phone" required placeholder="+91 98765 43210" />
                </div>
              </div>

              <div class="form-field">
                <label for="close-email">EMAIL</label>
                <input type="email" id="close-email" name="email" required placeholder="your.name@company.com" />
              </div>

              <div class="form-field">
                <label for="close-building-type">BUILDING TYPE</label>
                <div class="select-wrapper">
                  <select id="close-building-type" name="building_type" required>
                    <option value="" disabled selected>Select building type</option>
                    <option value="Corporate & Offices">Corporate &amp; Offices</option>
                    <option value="Institutions & Colleges">Institutions &amp; Colleges</option>
                    <option value="Hospitals & Healthcare Facilities">Hospitals &amp; Healthcare Facilities</option>
                    <option value="Manufacturing / Industrial">Manufacturing / Industrial</option>
                    <option value="Religious & Government Buildings">Religious &amp; Government Buildings</option>
                    <option value="Other Commercial">Other Commercial Facility</option>
                  </select>
                </div>
              </div>

              <div class="form-field">
                <label for="close-message">WHAT DO YOU WANT TO RENOVATE?</label>
                <textarea id="close-message" name="message" rows="3" placeholder="Describe the scope, areas, or goals..."></textarea>
              </div>

              <button type="submit" class="submit-amber-btn">
                SCHEDULE A SITE ASSESSMENT
              </button>

              <div class="form-response" aria-live="polite"></div>

              <p class="assessment-footer-text">
                Prefer to talk? Call <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="phone-link">{siteData.contact.phone}</a>
              </p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

