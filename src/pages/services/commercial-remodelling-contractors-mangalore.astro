  {
    phase: "Handover",
    stepRange: "STEPS 8–10",
    steps: [
      {
        num: "08",
        title: "Inspections and Quality Checks",
        desc: "Verifying that the work meets the agreed specifications, applicable building codes, and relevant safety and performance requirements."
      },
      {
        num: "09",
        title: "Finishing and Cleanup",
        desc: "Completing painting, flooring, fixtures, final detailing, and thorough site cleanup."
      },
      {
        num: "10",
        title: "Final Walkthrough and Handover",
        desc: "Reviewing the completed project, resolving outstanding issues, and handing over relevant documentation, warranties, and maintenance information."
      }
    ]
  }
];

const benefitsList = [
  {
    num: "01",
    title: "Rebranding Opportunity",
    desc: "When companies choose rebranding, one of the first decisions they typically make is changing the look and feel of their workspace. Matching the appearance of the business and the brand is one way companies spread and reinforce their message."
  },
  {
    num: "02",
    title: "Improved Use of Space",
    desc: "Optimum utilisation of space is critical for businesses expanding in future or already expanding. Installation of custom cabinetry, redesign of offices and cubicles, redesigning storage areas are effective ways to free up office space."
  },
  {
    num: "03",
    title: "Better Safety",
    desc: "Older buildings are often unsafe for workers and customers because they do not meet modern safety standards. Many companies remodel their premises to prevent accidents in the workplace."
  },
  {
    num: "04",
    title: "Reduction in Energy Bills",
    desc: "Older buildings waste energy through outdated lighting, poor insulation and inefficient cooling. A remodel lets you replace these with modern systems that use less power, so your bills drop every month. We compare upgrade options by life cycle cost, so you choose the ones that pay for themselves over time."
  },
  {
    num: "05",
    title: "Sustainable & Healthier Workspace",
    desc: "Green building practices help the environment and the people inside your building. Eco-friendly materials, rainwater harvesting and better use of natural light cut waste and create a space where staff and visitors feel better."
  },
  {
    num: "06",
    title: "Improved Indoor Air Quality",
    desc: "Stale air, damp walls and dust make a workspace uncomfortable. A remodel lets you upgrade ventilation, fix leaks and moisture problems, and choose finishes that keep the air cleaner. Cleaner air helps your team stay comfortable and focused through the workday."
  }
];

const testimonialsList = [
  {
    quote: "The Best Team I have ever worked with. Their dedication and commitment to quality are unmatched in the industry.",
    author: "City Developers",
    location: "Udupi"
  },
  {
    quote: "Excellent execution of our project from start to finish. Highly professional and always on time.",
    author: "Raghu",
    location: "Udupi"
  },
  {
    quote: "Outstanding work quality and exceptional project management skills. Delivered exactly what was promised.",
    author: "Prasanna K R",
    location: "Ocean Pearl, Bejai Kapikad"
  }
];

const warningSigns = [
  {
    num: "01",
    category: "Corporate & Offices",
    desc: "One of the major signs for office remodelling is unorganised space that can often lead to lost documents. Offices also become cluttered or cramped as companies grow. Oftentimes, the desire to remodel office space comes from changes occurring within the company.",
    signs: [
      "Reduction in productivity of employees",
      "Less space for workers",
      "Wall paint colors are outdated",
      "Space is disorganized & documents are often lost",
      "Fixtures are inefficient"
    ],
    solution: "We redesign layouts to match your current headcount, fix worn finishes, and redesign storage so documents and equipment have a proper place."
  },
  {
    num: "02",
    category: "Institutions",
    desc: "Floors in institutional buildings can wear quickly, as they get continuous traffic from stakeholders. Remodels for academic buildings can vary depending on the type of institution.",
    signs: [
      "Reduced attention in classrooms",
      "Lack of storage space",
      "Facilities need constant repair",
      "There aren’t enough classrooms",
      "Student strength has outgrown the space"
    ],
    solution: "We’ve built and renovated engineering colleges, education institutions, and hostels — we expand and reinforce space to handle heavy daily student use."
  },
  {
    num: "03",
    category: "Hospitals & Healthcare Facilities",
    desc: "Hospitals and healthcare facilities carry zero room for error during a remodel — operations and patient care can’t simply pause. We plan these projects in careful phases so care continues uninterrupted while work proceeds.",
    signs: [
      "The number of patients or staff has outgrown current capacity",
      "Infrastructure limiting department growth",
      "Equipment areas that can’t accommodate newer machinery",
      "A building that no longer meets updated health standards"
    ],
    solution: "We phase every healthcare remodel around your operational needs, so patient care and daily functions continue without compromise from start to finish. We also upgrade your facility to meet current health standards and make room for modern equipment."
  },
  {
    num: "04",
    category: "Manufacturing / Industrial",
    desc: "Manufacturing sites need regular repair because they’re in constant use by workers. Mechanical fixtures must be repaired regularly.",
    signs: [
      "New tenant relocation",
      "Production can’t meet the demand",
      "Inefficient equipment, or equipment that does not meet industry standards",
      "Facilities release pollution"
    ],
    solution: "Our V.D.F. industrial flooring and structural reconfiguration work is built for heavy, continuous operational use — including fast turnarounds when a new tenant moves in."
  },
  {
    num: "05",
    category: "Religious & Government Buildings",
    desc: "Religious and government buildings serve the public continuously. These buildings need safe and dignified space for daily public use, often while hosting large gatherings, events, or services.",
    signs: [
      "Worn out electrical, plumbing, or structural systems that no longer meet current public safety codes",
      "Outdated or insufficient electrical capacity for modern lighting, sound systems, or HVAC during events",
      "Seating, hall, or gathering space that can’t accommodate current attendance"
    ],
    solution: "We bring the same precision we use for new religious and government construction to renovation work — respecting the building’s existing character while bringing safety and capacity up to current standards."
  }
];

const qualitySteps = [
  {
    num: "1",
    title: "Punch-list resolution",
    desc: "Every outstanding item addressed with your facility manager before handover."
  },
  {
    num: "2",
    title: "Full site clean-up",
    desc: "Debris cleared, space ready for immediate use."
  },
  {
    num: "3",
    title: "Final walkthrough",
    desc: "We review the completed work together and resolve anything you raise before calling the project done."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Top Utility Bar -->
  <div class="top-utility-bar">
    <div class="container utility-inner">
      <div class="utility-left">
        <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="utility-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>{siteData.contact.phone}</span>
        </a>
        <span class="utility-divider">·</span>
        <a href={`mailto:${siteData.contact.email}`} class="utility-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span>{siteData.contact.email}</span>
        </a>
      </div>
      <div class="utility-right">
        <span>Mangalore · Udupi · Coastal Karnataka</span>
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="remodel-hero hero" id="top">
    <div class="container hero-container">
      <div class="hero-grid">
        
        <!-- Left: Copy & Actions -->
        <div class="hero-left">
          <div class="section-tag reveal">
            <span class="tag-diamond">◆</span>
            <span class="tag-text">SERVICES / COMMERCIAL RENOVATION</span>
          </div>

          <h1 class="hero-headline reveal">
            Commercial Remodelling &amp; Renovation Contractors In Coastal <span class="highlight-amber">Karnataka</span>
          </h1>

          <p class="hero-subtext reveal">
            We deliver tailored remodelling solutions for commercial, institutional, and industrial facilities utilizing strategic planning to safeguard and enhance property value.
          </p>

          <div class="hero-ctas reveal">
            <a href="#hero-assessment-form" class="cta-amber-btn scroll-to-form">
              ENQUIRE COMMERCIAL REMODELLING
            </a>
            <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="cta-outline-btn">
              CALL {siteData.contact.phone}
            </a>
          </div>

          <!-- Hero Proof Stats -->
          <div class="hero-proof-stats reveal">
            <div class="proof-stat-item">
              <span class="proof-number">15+</span>
              <span class="proof-label">Completed projects</span>
            </div>
            <div class="proof-stat-item">
              <span class="proof-title">Quality · Speed · Experience</span>
              <span class="proof-label">What we stand for</span>
            </div>
            <div class="proof-stat-item">
              <span class="proof-title">Mangalore · Udupi</span>
              <span class="proof-label">Where we work</span>
            </div>
          </div>
        </div>

        <!-- Right: Assessment Form Card -->
        <div class="hero-right reveal">
          <div class="assessment-card" id="hero-assessment-form">
            <div class="assessment-header">
              <h3 class="assessment-title">Schedule a Site Assessment</h3>
              <p class="assessment-subtitle">Tell us about your building and our experts will get back to you.</p>
            </div>

            <form class="assessment-form site-form" data-form-id="hero-form">
              <div class="form-row-split">
                <div class="form-field">
                  <label for="hero-name">FULL NAME</label>
                  <input type="text" id="hero-name" name="name" required placeholder="Your full name" />
                </div>
                <div class="form-field">
                  <label for="hero-phone">PHONE NUMBER</label>
                  <input type="tel" id="hero-phone" name="phone" required placeholder="+91 98765 43210" />
                </div>
              </div>

              <div class="form-field">
                <label for="hero-email">EMAIL</label>
                <input type="email" id="hero-email" name="email" required placeholder="your.name@company.com" />
              </div>

              <div class="form-field">
                <label for="hero-building-type">BUILDING TYPE</label>
                <div class="select-wrapper">
                  <select id="hero-building-type" name="building_type" required>
                    <option value="" disabled selected>Select building type</option>
                    <option value="Corporate & Offices">Corporate &amp; Offices</option>
                    <option value="Institutions & Colleges">Institutions &amp; Colleges</option>
                    <option value="Hospitals & Healthcare Facilities">Hospitals &amp; Healthcare Facilities</option>
                    <option value="Manufacturing / Industrial">Manufacturing / Industrial</option>
                    <option value="Religious & Government Buildings">Religious &amp; Government Buildings</option>
                    <option value="Other Commercial">Other Commercial Facility</option>
                  </select>
                </div>
              </div>

              <div class="form-field">
                <label for="hero-message">WHAT DO YOU WANT TO RENOVATE?</label>
                <textarea id="hero-message" name="message" rows="3" placeholder="Describe the scope, areas, or goals..."></textarea>
              </div>

              <button type="submit" class="submit-amber-btn">
                REQUEST SITE ASSESSMENT
              </button>

              <div class="form-response" aria-live="polite"></div>

              <p class="assessment-footer-text">
                Prefer to talk? Call <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="phone-link">{siteData.contact.phone}</a>
              </p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Trusted By Section -->
  <section class="trusted-section">
    <div class="container trusted-container">
      <div class="trusted-label">TRUSTED BY</div>
      <div class="trusted-clients-grid">
        {trustedClients.map((client) => (
          <span class="trusted-client-name">{client}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 01: Overview -->
  <section class="section-paper section-overview" id="overview">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">01 / OVERVIEW</span>
      </div>

      <div class="overview-grid">
        <div class="overview-left reveal">
          <h2 class="overview-headline">
            Commercial remodelling is one of the major considerations for any business to stay <span class="highlight-amber">relevant, productive &amp; functional.</span>
          </h2>
        </div>
        <div class="overview-right reveal">
          <p class="overview-body">
            Poorly maintained commercial buildings can lose their efficiency, appeal, and long-term value over time. Working with an experienced contractor and collaborating closely throughout the planning stages is key to a successful commercial renovation that enhances performance, elevates aesthetics, and meets contemporary standards.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Expertise -->
  <section class="section-paper section-expertise" id="expertise">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">02 / EXPERTISE</span>
      </div>

      <div class="expertise-grid">
        <div class="expertise-left reveal">
          <h2 class="expertise-heading">Our Expertise In Building Renovation</h2>
          <p class="expertise-sub">
            We handle commercial remodelling end-to-end, drawing on capabilities we’ve built across more than 15 completed projects:
          </p>
          <a href="#hero-assessment-form" class="enquire-arrow-link scroll-to-form">
            <span>ENQUIRE ABOUT YOUR PROJECT</span>
            <span class="arrow-symbol">→</span>
          </a>
        </div>

        <div class="expertise-right">
          <div class="expertise-list">
            {expertiseList.map((item) => (
              <div class="expertise-item reveal">
                <span class="expertise-num">{item.num}</span>
                <div class="expertise-content">
                  <h3 class="expertise-title">{item.title}</h3>
                  <p class="expertise-desc">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Slim Bar After Expertise -->
  <section class="slim-cta-bar">
    <div class="container slim-cta-inner">
      <div class="slim-cta-left">
        <h3 class="slim-cta-title">Have a building in mind?</h3>
        <p class="slim-cta-desc">Tell us what you want to renovate and our experts will take it from there.</p>
      </div>
      <div class="slim-cta-right">
        <a href="#hero-assessment-form" class="cta-amber-btn scroll-to-form">
          ENQUIRE COMMERCIAL REMODELLING
        </a>
      </div>
    </div>
  </section>

  <!-- Section 03: Process -->
  <section class="section-charcoal section-process" id="process">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">03 / PROCESS</span>
      </div>

      <div class="process-header reveal">
        <h2 class="section-title-white">Steps Involved In Commercial Remodelling</h2>
        <p class="process-intro">
          Every commercial remodelling project is unique, depending on the building type, location, business requirements, and scope of work. However, most commercial renovation projects follow a structured process to ensure efficient execution, quality results, and minimal disruption to business operations.
        </p>
        <p class="process-intro-sub">
          A typical commercial renovation project involves the following stages:
        </p>
      </div>

      <!-- 3 Phase Columns -->
      <div class="phases-grid">
        {processPhases.map((phase) => (
          <div class="phase-column reveal">
            <div class="phase-header-bar">
              <h3 class="phase-name">{phase.phase}</h3>
              <span class="phase-step-range">{phase.stepRange}</span>
            </div>
            <div class="phase-steps-list">
              {phase.steps.map((st) => (
                <div class="phase-step-item">
                  <span class="phase-step-num">{st.num}</span>
                  <div class="phase-step-body">
                    <h4 class="phase-step-title">{st.title}</h4>
                    <p class="phase-step-desc">{st.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Related Reading Card -->
      <div class="related-reading-box reveal">
        <div class="related-reading-inner">
          <div class="related-reading-left">
            <span class="related-tag">RELATED READING</span>
            <h3 class="related-title">How to optimise budget for commercial building construction</h3>
            <p class="related-sub">Understand the budget optimization in detail.</p>
          </div>
          <a href="/blog/7-ways-to-optimise-budget-for-commercial-building-construction/" class="related-arrow-btn" aria-label="Read full article on budget optimization">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Amber Band After Process -->
  <section class="amber-banner">
    <div class="container amber-banner-inner">
      <div class="amber-banner-left">
        <h2 class="amber-banner-heading">
          Looking To Hire Commercial Remodelling Contractors In Mangalore / Udupi?
        </h2>
        <p class="amber-banner-sub">
          Contact our experts to explore options and decide what works best for you.
        </p>
      </div>
      <div class="amber-banner-right">
        <a href="#hero-assessment-form" class="cta-dark-btn scroll-to-form">
          ENQUIRE COMMERCIAL REMODELLING
        </a>
        <span class="amber-banner-call">
          or call <a href={`tel:${siteData.contact.phone.replace(/\s/g, '')}`} class="banner-tel-link">{siteData.contact.phone}</a>
        </span>
      </div>
    </div>
  </section>

  <!-- Section 04: Benefits -->
  <section class="section-paper section-benefits" id="benefits">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">04 / BENEFITS</span>
      </div>

      <div class="section-heading-wrap reveal">
        <h2 class="section-title-dark">6 Advantages Of Commercial Remodelling / Renovation</h2>
      </div>

      <div class="benefits-grid">
        {benefitsList.map((benefit) => (
          <div class="benefit-card reveal">
            <span class="benefit-number">{benefit.num}</span>
            <h3 class="benefit-title">{benefit.title}</h3>
            <p class="benefit-desc">{benefit.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section-charcoal section-testimonials" id="testimonials">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">TESTIMONIALS</span>
      </div>

      <div class="testimonials-header reveal">
        <h2 class="section-title-white">What Our Clients Say</h2>
      </div>

      <div class="testimonials-grid">
        {testimonialsList.map((t) => (
          <div class="testimonial-card reveal">
            <span class="quote-mark">“</span>
            <p class="testimonial-quote">{t.quote}</p>
            <div class="testimonial-author">
              <strong class="author-name">{t.author}</strong>
              <span class="author-loc">{t.location}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 05: Warning Signs & Solutions -->
  <section class="section-paper section-warning-signs" id="warning-signs">
    <div class="container">
      <div class="section-tag reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">05 / WARNING SIGNS</span>
      </div>

      <div class="warning-signs-header reveal">
        <h2 class="section-title-dark">Warning Signs You Need A Commercial Remodelling</h2>
        <p class="warning-signs-intro">
          As a commercial property owner, watch out for the warning signs by getting feedback from clients and employees and by inspecting your property regularly. See the list of warning signs below categorized by building type:
        </p>
      </div>

      <div class="industry-subheading reveal">
        <span class="tag-diamond">◆</span>
        <span class="tag-text">INDUSTRY-SPECIFIC SIGNS &amp; SOLUTIONS</span>
      </div>

      <div class="warning-modules-list">
        {warningSigns.map((item) => (
          <div class="warning-module-card reveal">
            <div class="warning-module-grid">
              
              <!-- Left: Number & Building Type -->
              <div class="warning-module-left">
                <span class="module-num">{item.num}</span>
                <h3 class="module-title">{item.category}</h3>
              </div>

              <!-- Right: Content, Signs, & Solution -->
              <div class="warning-module-right">
                <p class="module-desc">{item.desc}</p>

                <div class="signs-box">
                  <span class="signs-label">SIGNS TO WATCH FOR</span>
                  <ul class="signs-list">
                    {item.signs.map((sign) => (
                      <li class="sign-item">
                        <span class="sign-bullet">■</span>
                        <span>{sign}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="solution-box">
                  <span class="solution-label">OUR SOLUTION</span>
                  <p class="solution-text">{item.solution}</p>
                </div>
              </div>

            </div>
          </div>
