---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/global/PageHero.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
---

<BaseLayout title="Projects">
  <PageHero
    eyebrow="Selected Works"
    title="Projects That<br/>Shape Places."
    subtitle="Explore our portfolio of apartments, healthcare facilities, educational institutions, commercial complexes, and residential buildings."
    image="/images/slider3.jpg"
    size="large"
  />

  <section class="projects-page section-pad section-muted">
    <div class="container">
      <ProjectGrid />
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
