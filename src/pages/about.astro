---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stats from '../components/home/Stats.astro';
import Certifications from '../components/about/Certifications.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import { siteData } from '../data/site';
---

<BaseLayout title="About Us">
  <section class="page-header section-pad" style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/images/ASHOKA-PARADISE.jpg'); background-size: cover; background-position: center; min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--c-white); padding-top: calc(var(--header-height) + var(--space-lg)); margin-top: calc(var(--header-height) * -1);">
    <div class="container" style="padding-top: var(--header-height);">
      <span class="text-eyebrow reveal" style="color: var(--c-accent);">About Sri Lakshmi Construction</span>
      <h1 class="text-h1 reveal" style="transition-delay: 0.1s; margin-top: 1rem;">
        21 Years of Experience. <br/>
        Built on Trust. Driven by Possibility.
      </h1>
    </div>
  </section>

  <Stats />

  <section class="about-content section-pad" style="padding-top: 0;">
    <div class="container">
      <div class="about-grid">
        <div class="about-text reveal">
          <p class="text-body" style="font-size: 1.5rem; margin-bottom: 2rem; color: var(--c-charcoal);">
            We have built our reputation as a construction services firm that puts people first.
          </p>
          <p class="text-body" style="margin-bottom: 1.5rem;">
            {siteData.name} was established in 2012. Since our inception, we have been committed to delivering world-class engineering and construction services across Mangalore, Udupi, and beyond.
          </p>
          <p class="text-body">
            We specialize in building Apartments, Healthcare Buildings, Educational Institutions, Commercial Complexes, and a variety of specialized construction projects including Landscape and Green Construction.
          </p>
        </div>
        
        <div class="founder-card reveal" style="transition-delay: 0.2s;">
          <div class="founder-image-wrapper">
            <img src="/images/suresh.png" alt={siteData.founder.name} onerror="this.src='/images/srilakshmiconstructionlogo-1.png'" class="founder-img" />
          </div>
          <div class="founder-info">
            <h3 class="text-h3">{siteData.founder.name}</h3>
            <p class="text-eyebrow" style="margin-bottom: 0.5rem;">{siteData.founder.title}</p>
            <p class="text-body" style="font-size: 0.875rem;">
              {siteData.founder.experience} of experience in the construction field.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-team section-pad" style="background-color: var(--c-charcoal); color: var(--c-white);">
    <div class="container">
      <div class="reveal" style="max-width: 900px; margin: 0 auto; text-align: center;">
        <span class="text-eyebrow" style="color: var(--c-accent);">Our Philosophy</span>
        <h2 class="text-h2" style="margin: 1rem 0 2rem; color: var(--c-white);">Teamwork & Collaboration</h2>
        <p class="text-body" style="font-size: 1.25rem; color: var(--c-off-white);">
          Sri Lakshmi Construction is committed to construct office buildings to recreation centers and municipal facilities, designing and building a successful project which requires more than meeting the schedule and budget. A truly successful project is rooted in teamwork and derived from a passion to ensure all of your project expectations are exceeded.
        </p>
      </div>
    </div>
  </section>

  <Certifications />

  <FinalCTA />
</BaseLayout>

<style>
  .page-header {
    /* Styles handled inline for background */
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 3fr 2fr;
    }
  }

  .founder-card {
    background-color: var(--c-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
  }

  .founder-image-wrapper {
    aspect-ratio: 4/3;
    background-color: var(--c-grey-light);
    overflow: hidden;
  }

  .founder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%);
  }

  .founder-info {
    padding: 2rem;
  }
</style>
