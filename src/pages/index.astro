---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import IntroStatement from '../components/home/IntroStatement.astro';
import Stats from '../components/home/Stats.astro';
import ServicesPreview from '../components/home/ServicesPreview.astro';
import ProjectShowcase from '../components/home/ProjectShowcase.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Clients from '../components/home/Clients.astro';
import FinalCTA from '../components/home/FinalCTA.astro';

const seoTitle = "Sri Lakshmi Construction | construction company in Mangalore";
const seoDescription = "Trusted construction company in Mangalore & Udupi since 2012. Specialists in turnkey commercial complexes, custom homes, and VDF flooring.";
const seoKeywords = "Construction companies in Mangalore";
---

<BaseLayout title={seoTitle} description={seoDescription} keywords={seoKeywords}>
  <Hero />
  <IntroStatement />
  <Stats />
  <ServicesPreview />
  <ProjectShowcase />
  <Testimonials />
  <Clients />
  <FinalCTA />
</BaseLayout>
