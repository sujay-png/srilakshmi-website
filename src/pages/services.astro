---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import { services } from '../data/services';
---

<BaseLayout title="Services">
  <section class="page-header section-pad" style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/images/srilakshmicontructionwork.png'); background-size: cover; background-position: center; min-height: 40vh; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--c-white); padding-top: calc(var(--header-height) + var(--space-lg)); margin-top: calc(var(--header-height) * -1);">
    <div class="container" style="padding-top: var(--header-height);">
      <span class="text-eyebrow reveal" style="color: var(--c-accent);">Our Expertise</span>
      <h1 class="text-h1 reveal" style="transition-delay: 0.1s; margin-top: 1rem;">
        Comprehensive Construction &amp; <br/> Engineering Services
      </h1>
    </div>
  </section>

  <section class="services-list section-pad">
    <div class="container">
      <div class="services-grid">
        {services.map((service, index) => (
          <div class="service-card reveal" style={`transition-delay: ${(index % 3) * 0.1}s;`}>
            <div class="service-image-wrapper">
              <img src={service.image} alt={service.title} loading="lazy" />
            </div>
            <div class="service-content">
              <h3 class="text-h3" style="margin-bottom: 1rem;">{service.title}</h3>
              <p class="text-body">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .page-header {
    background-color: var(--c-soft-white);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background-color: var(--c-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .service-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
  }

  .service-image-wrapper {
    aspect-ratio: 16/10;
    overflow: hidden;
    background-color: var(--c-grey-light);
  }

  .service-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .service-card:hover .service-image-wrapper img {
    transform: scale(1.05);
  }

  .service-content {
    padding: 2rem;
  }
</style>
